        </Field>
        <Field Name="VA_DIAS_RESTANTES2">
          <DataField>VA_DIAS_RESTANTES2</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
        <Field Name="CARGO">
          <DataField>CARGO</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="VA_HORAS_RESTANTES2">
          <DataField>VA_HORAS_RESTANTES2</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
        <Field Name="UNIDAD">
          <DataField>UNIDAD</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="VA_FECHA_INGRESO2">
          <DataField>VA_FECHA_INGRESO2</DataField>
          <rd:TypeName>System.DateTime</rd:TypeName>
        </Field>
        <Field Name="NOM">
          <DataField>NOM</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="vac_lj">
          <DataField>vac_lj</DataField>
          <rd:TypeName>System.Object</rd:TypeName>
        </Field>
      </Fields>
    </DataSet>
