<?xml version="1.0" encoding="utf-8"?>
<Report MustUnderstand="df" xmlns="http://schemas.microsoft.com/sqlserver/reporting/2016/01/reportdefinition" xmlns:rd="http://schemas.microsoft.com/SQLServer/reporting/reportdesigner" xmlns:df="http://schemas.microsoft.com/sqlserver/reporting/2016/01/reportdefinition/defaultfontfamily">
  <df:DefaultFontFamily>Segoe UI</df:DefaultFontFamily>
  <AutoRefresh>0</AutoRefresh>
  <DataSources>
    <DataSource Name="Planillas">
      <DataSourceReference>Planillas</DataSourceReference>
      <rd:SecurityType>None</rd:SecurityType>
      <rd:DataSourceID>84ec12bd-584f-492d-914c-7dc2272c783b</rd:DataSourceID>
    </DataSource>
  </DataSources>
  <DataSets>
    <DataSet Name="DataSet1">
      <Query>
        <DataSourceName>Planillas</DataSourceName>
        <QueryParameters>
          <QueryParameter Name="@vac_lj">
            <Value>=Parameters!vac_lj.Value</Value>
          </QueryParameter>
          <QueryParameter Name="@cod_persona">
            <Value>=Parameters!cod_persona.Value</Value>
          </QueryParameter>
        </QueryParameters>
        <CommandText>DECLARE @ID INT,@VA_ID INT, @VA_PER_ID INT, @VA_GESTION NVARCHAR(20), @VA_DIAS_LEY INT, @VA_DIAS_RESTANTES INT, @VA_HORAS_RESTANTES INT,@VA_FECHA_INGRESO DATETIME,
					 @VA_ESTADO NVARCHAR(3), @CARGO NVARCHAR(50),@UNIDAD NVARCHAR(250),@NOM  NVARCHAR(100)

DECLARE @VACACION TABLE( VA_ID INT, VA_PER_ID INT, VA_GESTION1 NVARCHAR(20), VA_DIAS_LEY1 INT, VA_DIAS_RESTANTES1 INT, VA_HORAS_RESTANTES1 INT,
					VA_GESTION2 NVARCHAR(20), VA_DIAS_LEY2 INT, VA_DIAS_RESTANTES2 INT, VA_HORAS_RESTANTES2 INT,VA_FECHA_INGRESO2 DATETIME, VA_ESTADO NVARCHAR(3), CARGO NVARCHAR(50),UNIDAD NVARCHAR(250),NOM  NVARCHAR(100))
--(VA_ID, VA_PER_ID, VA_GESTION1, VA_DIAS_LEY1, VA_DIAS_RESTANTES1, VA_HORAS_RESTANTES1, VA_GESTION2, VA_DIAS_LEY2, VA_DIAS_RESTANTES2, VA_HORAS_RESTANTES2,VA_FECHA_INGRESO2, VA_ESTADO, CARGO,UNIDAD,NOM )

		DECLARE CurVACACION CURSOR SCROLL FOR (
		SELECT top 1 ROW_NUMBER() OVER(PARTITION BY AV.va_per_id ORDER BY AV.va_gestion_inicio desc),AV.va_id, AV.va_per_id, 
				CONCAT(RTRIM(LTRIM(AV.va_gestion_inicio)), ' - ', RTRIM(LTRIM(AV.va_gestion_fin)), ' ') AS va_gestion ,
				AV.va_dias_ley, AV.va_dias_restantes, AV.va_horas_restantes, 
				AV.va_fecha_ingreso_r AS va_fecha_ingreso,--FORMAT(AV.va_fecha_ingreso_r, 'dd/MM/yyyy') AS va_fecha_ingreso,
				AV.va_estado
				,ES.es_descripcion AS CARGO, EO.eo_descripcion AS UNIDAD--, DBO.fn_Fecha_Ingreso( AV.va_per_id ,'01/01/1900')
				,CONCAT(RTRIM(LTRIM(P.per_nombres)), ' ', RTRIM(LTRIM(P.per_ap_paterno)), ' ', RTRIM(LTRIM(P.per_ap_materno)), ' ') AS nombre_fun
				FROM [tbl_kd_asignacion_vacacion] AV INNER  JOIN
				tbl_mp_asignacion A ON A.as_per_id = AV.va_per_id AND A.as_estado ='V' JOIN
				tbl_mp_cargo C ON A.as_ca_id = C.ca_id INNER JOIN
				tbl_mp_estructura_organizacional EO ON C.ca_eo_id = EO.eo_id INNER JOIN
				tbl_mp_escala_salarial ES ON C.ca_es_id= ES.es_id INNER JOIN
				tbl_mp_tipo_item T ON C.ca_ti_item = T.ti_item INNER JOIN
				tbl_persona P ON P.per_id = A.as_per_id
				WHERE AV.va_estado = 'V' AND AV.va_per_id = @cod_persona 
				AND (AV.va_dias_restantes &gt; 0 OR AV.va_horas_restantes &gt; 0)
				--AND T.ti_tipo_item_gral ='P' 
				AND T.ti_tipo ='ADM'
				GROUP BY AV.va_id, AV.va_per_id, AV.va_gestion_inicio, AV.va_gestion_fin ,
				AV.va_dias_ley, AV.va_dias_restantes, AV.va_horas_restantes,AV.va_fecha_ingreso_r, AV.va_estado
				,ES.es_descripcion , EO.eo_descripcion , CONCAT(RTRIM(LTRIM(P.per_nombres)), ' ', RTRIM(LTRIM(P.per_ap_paterno)), ' ', RTRIM(LTRIM(P.per_ap_materno)), ' ') 
				
		)ORDER BY 1 DESC
		OPEN CurVACACION
		FETCH FIRST FROM CurVACACION INTO @ID,@VA_ID, @VA_PER_ID, @VA_GESTION, @VA_DIAS_LEY, @VA_DIAS_RESTANTES, @VA_HORAS_RESTANTES,@VA_FECHA_INGRESO, @VA_ESTADO, @CARGO,@UNIDAD,@NOM
		WHILE @@FETCH_STATUS = 0
		BEGIN

				 IF 1 = (SELECT COUNT(*)
				FROM [tbl_kd_asignacion_vacacion] AV INNER  JOIN
				tbl_mp_asignacion A ON A.as_per_id = AV.va_per_id AND A.as_estado ='V' JOIN
				tbl_mp_cargo C ON A.as_ca_id = C.ca_id INNER JOIN
				tbl_mp_estructura_organizacional EO ON C.ca_eo_id = EO.eo_id INNER JOIN
				tbl_mp_escala_salarial ES ON C.ca_es_id= ES.es_id INNER JOIN
				tbl_mp_tipo_item T ON C.ca_ti_item = T.ti_item INNER JOIN
				tbl_persona P ON P.per_id = A.as_per_id
				WHERE AV.va_estado = 'V' AND av.va_id= @VA_ID
				AND (AV.va_dias_restantes &gt; 0 OR AV.va_horas_restantes &gt; 0)
				AND T.ti_tipo_item_gral ='P' AND T.ti_tipo ='ADM'
				GROUP BY AV.va_id, AV.va_per_id, AV.va_gestion_inicio, AV.va_gestion_fin ,
				AV.va_dias_ley, AV.va_dias_restantes, AV.va_horas_restantes, FORMAT(AV.va_fecha_ingreso_r, 'dd/MM/yyyy'), AV.va_estado
				,ES.es_descripcion , EO.eo_descripcion , CONCAT(RTRIM(LTRIM(P.per_nombres)), ' ', RTRIM(LTRIM(P.per_ap_paterno)), ' ', RTRIM(LTRIM(P.per_ap_materno)), ' ') )
				BEGIN
				INSERT INTO @VACACION
				VALUES( @VA_ID, @VA_PER_ID,@VA_GESTION, @VA_DIAS_LEY, @VA_DIAS_RESTANTES, @VA_HORAS_RESTANTES, '', 0, 0, 0,		@VA_FECHA_INGRESO,@VA_ESTADO, @CARGO,@UNIDAD,@NOM)
				END
				ELSE
				 BEGIN
						IF @ID=2
						BEGIN
								INSERT INTO @VACACION
								VALUES( @VA_ID, @VA_PER_ID, '', 0, 0, 0,
										@VA_GESTION, @VA_DIAS_LEY, @VA_DIAS_RESTANTES, @VA_HORAS_RESTANTES,
										@VA_FECHA_INGRESO,@VA_ESTADO, @CARGO,@UNIDAD,@NOM)
								--FROM @VACACION WHERE 1=1
						END
						ELSE
						BEGIN
								UPDATE @VACACION
								SET VA_GESTION1=@VA_GESTION,
									VA_DIAS_LEY1 = @VA_DIAS_LEY,
									VA_DIAS_RESTANTES1 = @VA_DIAS_RESTANTES,
									VA_HORAS_RESTANTES1= @VA_HORAS_RESTANTES
								WHERE VA_PER_ID = @VA_PER_ID 
						END
				END

		FETCH NEXT FROM CurVACACION  INTO @ID, @VA_ID, @VA_PER_ID, @VA_GESTION, @VA_DIAS_LEY, @VA_DIAS_RESTANTES, @VA_HORAS_RESTANTES,@VA_FECHA_INGRESO, @VA_ESTADO, @CARGO,@UNIDAD,@NOM
		END
		CLOSE CurVACACION
		DEALLOCATE CurVACACION

		SELECT *, @vac_lj as vac_lj FROM @VACACION</CommandText>
        <rd:UseGenericDesigner>true</rd:UseGenericDesigner>
      </Query>
