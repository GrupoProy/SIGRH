    <DataSet Name="DataSet2">
      <Query>
        <DataSourceName>Planillas</DataSourceName>
        <QueryParameters>
          <QueryParameter Name="@cod_persona">
            <Value>=Parameters!cod_persona.Value</Value>
          </QueryParameter>
        </QueryParameters>
        <CommandText>SELECT DISTINCT 
                         dbo.HORA_TEXTO(convert(datetime,tbl_cp_tmp_horario.th_ing1,103)) AS th_ing1, dbo.HORA_TEXTO(convert(datetime,tbl_cp_tmp_horario.th_sal1,103)) AS th_sal1, 
dbo.HORA_TEXTO(convert(datetime,tbl_cp_tmp_horario.th_ing2,103)) AS th_ing2, dbo.HORA_TEXTO(convert(datetime,tbl_cp_tmp_horario.th_sal2,103)) 
                         AS th_sal2
FROM            tbl_cp_asignacion_horario INNER JOIN
                         General.dbo.tbl_catalogo ON tbl_cp_asignacion_horario.ah_tipo_horario = General.dbo.tbl_catalogo.cat_secuencial AND General.dbo.tbl_catalogo.cat_tabla LIKE 'TIPO_HORARIO%' AND 
                         tbl_cp_asignacion_horario.ah_estado = 'V' INNER JOIN
                         tbl_cp_tmp_horario ON tbl_cp_tmp_horario.th_per_id = @cod_persona</CommandText>
      </Query>
      <Fields>
        <Field Name="th_ing1">
          <DataField>th_ing1</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="th_sal1">
          <DataField>th_sal1</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="th_ing2">
          <DataField>th_ing2</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="th_sal2">
          <DataField>th_sal2</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
      </Fields>
    </DataSet>
