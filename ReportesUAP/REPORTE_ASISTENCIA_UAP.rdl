<?xml version="1.0" encoding="utf-8"?>
<Report MustUnderstand="df" xmlns="http://schemas.microsoft.com/sqlserver/reporting/2016/01/reportdefinition" xmlns:rd="http://schemas.microsoft.com/SQLServer/reporting/reportdesigner" xmlns:df="http://schemas.microsoft.com/sqlserver/reporting/2016/01/reportdefinition/defaultfontfamily">
  <df:DefaultFontFamily>Segoe UI</df:DefaultFontFamily>
  <AutoRefresh>0</AutoRefresh>
  <DataSources>
    <DataSource Name="Planillas">
      <ConnectionProperties>
        <DataProvider>SQL</DataProvider>
        <ConnectString>Data Source=172.16.21.100;Initial Catalog=sigrh3</ConnectString>
      </ConnectionProperties>
      <rd:SecurityType>DataBase</rd:SecurityType>
      <rd:DataSourceID>b1961b35-13b2-4506-96f0-8cd48e144051</rd:DataSourceID>
    </DataSource>
  </DataSources>
  <DataSets>
    <DataSet Name="DataSet1">
      <Query>
        <DataSourceName>Planillas</DataSourceName>
        <QueryParameters>
          <QueryParameter Name="@cod_persona">
            <Value>=Parameters!cod_persona.Value</Value>
          </QueryParameter>
          <QueryParameter Name="@f_ini">
            <Value>=Parameters!f_ini.Value</Value>
          </QueryParameter>
          <QueryParameter Name="@f_fin">
            <Value>=Parameters!f_fin.Value</Value>
          </QueryParameter>
        </QueryParameters>
        <CommandText>set dateformat dmy
SET LANGUAGE Español
------------
SELECT        T.att_id, T.att_per_id, General.dbo.tbl_catalogo.cat_descripcion AS TIPO_HORARIO,T.att_fecha, T.att_dia, 
		T.att_ing1,
		case  WHEN   att_tipo_observado='F'
			 then 'FERIADO'
			 when att_id_lic_ing1=0 then 'NO MARCO'
			 WHEN att_id_lic_ing1= -1 then DBO.HORA_TEXTO(att_ing1)
			 WHEN att_id_lic_ing1 NOT IN (-1,0)
			 then DBO.OBTENER_LICENCIA(att_id_lic_ing1)

			 ELSE DBO.HORA_TEXTO(att_ing1)
			 END AS ING1_TEXT,
			 --H.th_ing1,
		T.att_sal1,
		--left(convert(nvarchar(50),T.att_sal1),2)+':'+RIGHT(left(convert(nvarchar(50),T.att_sal1),5),2)+':'+RIGHT(left(convert(nvarchar(50),T.att_sal1),8),2) 
		case  WHEN att_tipo_observado='F' then 'FERIADO'
			 when att_id_lic_sal1=0 then 'NO MARCO'
			 WHEN att_id_lic_sal1= -1 then DBO.HORA_TEXTO(att_sal1)
			 WHEN att_id_lic_sal1 NOT IN (-1,0)
			 then DBO.OBTENER_LICENCIA(att_id_lic_sal1)

			 ELSE DBO.HORA_TEXTO(att_sal1)
			 END AS SAL1_TEXT,
	T.att_ing2,
	case when General.dbo.tbl_catalogo.cat_descripcion  = 'CONTINUO' THEN '' 
		 WHEN   att_tipo_observado='F' then 'FERIADO'
		 when att_id_lic_ing2=0 then 'NO MARCO'
		 WHEN att_id_lic_ing2= -1 then DBO.HORA_TEXTO(att_ing2)
		 WHEN att_id_lic_ing2 NOT IN (-1,0) then DBO.OBTENER_LICENCIA(att_id_lic_ing2)
		 ELSE DBO.HORA_TEXTO(att_ing2)
	END AS ING2_TEXT,

	T.att_sal2,
	case when General.dbo.tbl_catalogo.cat_descripcion  = 'CONTINUO' THEN '' 
		WHEN att_tipo_observado='F' then 'FERIADO'
		 when att_id_lic_sal2 =0 then 'NO MARCO'
		 WHEN att_id_lic_sal2= -1 then DBO.HORA_TEXTO(att_sal2)
		 WHEN att_id_lic_sal2 NOT IN (-1,0) then DBO.OBTENER_LICENCIA(att_id_lic_sal2)
		 ELSE DBO.HORA_TEXTO(att_sal2) 
	end AS SAL2_TEXT,


                         T.att_min_atraso as TOTALMINATRASO,
						 T.att_id_lic_ing1, T.att_id_lic_sal1, T.att_id_lic_ing2, T.att_id_lic_sal2, T.att_min_atraso, T.att_min_atraso_mayor30, 
						 --ISNULL(SUM(CASE WHEN T.att_tipo_observado LIKE '%A%' THEN 1 ELSE 0 END), 0) AS Tatrasos,
						 ISNULL(SUM(T.att_min_extras), 0) AS Tatrasos,
   --          case   WHEN   att_tipo_observado='S' THEN 'ABANDONO'
			--ELSE '' END AS att_min_salio_antes,-- 
			T.att_min_salio_antes,
						 T.att_min_extras, T.att_tipo_observado, T.att_id_horario, T.att_id_horario_esp, T.att_edificio, 
                          A.as_fecha_inicio, A.as_fecha_fin,
						  			ISNULL(SUM(CASE WHEN T.att_tipo_observado LIKE '%M%' THEN 1 ELSE 0 END), 0) AS MEDIODIA,
			ISNULL(SUM(CASE WHEN T.att_tipo_observado LIKE '%S%' THEN 1 ELSE 0 END), 0) AS SALIOANTES,
			ISNULL(SUM(CASE WHEN T.att_tipo_observado LIKE '%I%' THEN 1 ELSE 0 END), 0) AS TODOELDIA,
			ISNULL(SUM(CASE WHEN T.att_tipo_observado LIKE '%N%' THEN 1 ELSE 0 END), 0) AS NOMARCADOS,
			ISNULL(SUM(CASE WHEN ATT_id_lic_ING1 = 0 AND att_id_lic_sal1 &lt;&gt; 0 THEN 1 ELSE 0 END), 0) AS NOMARING,
			ISNULL(SUM(CASE WHEN ATT_id_liC_ING2 = 0 AND ATT_id_lic_SAL2 &lt;&gt; 0 THEN 1 ELSE 0 END), 0) AS NOMARING2,
			ISNULL(SUM(CASE WHEN att_id_lic_sal1 = 0 AND ATT_id_lic_ING1 &lt;&gt; 0 THEN 1 ELSE 0 END), 0) AS NOMARCSAL,
			ISNULL(SUM(CASE WHEN att_id_lic_sal2 = 0 AND ATT_id_lic_ING2 &lt;&gt; 0 THEN 1 ELSE 0 END), 0) AS NOMARCSAL2,
			ISNULL(SUM(CASE WHEN T.att_min_salio_antes &lt;&gt;0  THEN 1 ELSE 0 END), 0) AS ATRASOMASDE30MINUTOS,
			DBO.OBTENER_LICENCIA(T.att_id_horario_esp) AS LICENCIA, 'I1' A,
			case when T.att_tipo_observado  LIKE '%I%' THEN 'FALTA'
			ELSE '' END AS OBSERVACION,
			RTRIM(P.per_ap_paterno) + ' ' + RTRIM(P.per_ap_materno) + ' ' + RTRIM(ISNULL(P.per_ap_casada, N'')) 
                         + ' ' + RTRIM(P.per_nombres) NOMBRE_COMPLETO,
			tbl_mp_cargo.ca_ti_item+' '+CONVERT(NVARCHAR(5),tbl_mp_cargo.ca_num_item) ITEM,ES.es_descripcion AS CARGO,
			EO.eo_descripcion AS UNIDAD, CAT_E.cat_descripcion AS EDIFICIO, CASE WHEN TI.TI_TIPO='ADM' THEN 'PERSONAL ADMINISTRATIVO'
			WHEN TI.TI_TIPO='CON' THEN 'PERSONAL CONSULTOR DE LINEA' ELSE '' END TI_TIPO
FROM            tbl_mp_tipo_item AS TI INNER JOIN
                         tbl_mp_cargo ON TI.ti_item = tbl_mp_cargo.ca_ti_item INNER JOIN
                         tbl_mp_asignacion A ON tbl_mp_cargo.ca_id = A.as_ca_id AND A.as_estado &lt;&gt; 'S' INNER JOIN
                         tbl_cp_asistencia T ON A.as_per_id = T.att_per_id INNER JOIN
                         General.dbo.tbl_catalogo ON T.att_id_horario = General.dbo.tbl_catalogo.cat_secuencial LEFT OUTER JOIN
						 --tbl_cp_tmp_horario H ON H.th_per_id = T.att_per_id AND H.th_dia = DAY(T.att_fecha) INNER JOIN
						 TBL_PERSONA P ON P.per_id = A.as_PER_id INNER JOIN
						 tbl_mp_estructura_organizacional EO ON EO.eo_id = tbl_mp_cargo.ca_eo_id INNER JOIN
						 tbl_mp_escala_salarial ES ON ES.es_id =tbl_mp_cargo.ca_es_id left outer JOIN
						 tbl_cp_dispositivo DIS ON DIS.di_id = T.att_edificio  INNER JOIN
                         General.dbo.tbl_catalogo AS CAT_E ON T.att_edificio = CAT_E.cat_secuencial 
WHERE        (T.att_per_id = @cod_persona) AND TI.TI_TIPO IN ('ADM','CON') AND (General.dbo.tbl_catalogo.cat_tabla LIKE 'TIPO_HORAR%') 
and  T.att_fecha BETWEEN  convert(datetime, @f_ini ,103) AND convert(datetime,@f_fin,103)
AND (CAT_E.cat_tabla LIKE 'Edificio_Institucional%') AND A.as_estado&lt;&gt;'S' 
and  T.att_fecha BETWEEN  convert(datetime,A.as_fecha_inicio  ,103) AND ISNULL(convert(datetime,A.as_fecha_fin  ,103),convert(datetime,@f_fin,103))

group by  T.att_id, T.att_per_id, General.dbo.tbl_catalogo.cat_descripcion,T.att_fecha, T.att_dia, T.att_ing1, T.att_sal1, T.att_ing2, T.att_sal2, 
					 T.att_id_lic_ing1, T.att_id_lic_sal1, T.att_id_lic_ing2, T.att_id_lic_sal2, T.att_min_atraso, T.att_min_atraso_mayor30, 
                         T.att_min_salio_antes, T.att_min_extras, T.att_tipo_observado, T.att_id_horario, T.att_id_horario_esp, T.att_edificio, 
                          A.as_fecha_inicio, A.as_fecha_fin, P.per_ap_paterno,P.per_ap_materno,P.per_ap_casada,per_nombres,
			tbl_mp_cargo.ca_ti_item,tbl_mp_cargo.ca_num_item,ES.es_descripcion ,
			EO.eo_descripcion , DIS.di_id , CAT_E.cat_descripcion, TI.TI_TIPO
ORDER BY T.att_fecha</CommandText>
        <rd:UseGenericDesigner>true</rd:UseGenericDesigner>
      </Query>
