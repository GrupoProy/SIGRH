<?xml version="1.0" encoding="utf-8"?>
<Report MustUnderstand="df" xmlns="http://schemas.microsoft.com/sqlserver/reporting/2016/01/reportdefinition" xmlns:rd="http://schemas.microsoft.com/SQLServer/reporting/reportdesigner" xmlns:df="http://schemas.microsoft.com/sqlserver/reporting/2016/01/reportdefinition/defaultfontfamily">
  <df:DefaultFontFamily>Segoe UI</df:DefaultFontFamily>
  <AutoRefresh>0</AutoRefresh>
  <DataSources>
    <DataSource Name="Planillas">
      <ConnectionProperties>
        <DataProvider>SQL</DataProvider>
        <ConnectString>Data Source=181.115.221.99;Initial Catalog=sigrh3</ConnectString>
        <Prompt>Especifique un nombre de usuario y una contraseña para el origen de datos Planillas:</Prompt>
      </ConnectionProperties>
      <rd:SecurityType>DataBase</rd:SecurityType>
      <rd:DataSourceID>ba810aca-d4fd-4218-9ba8-8f51f261d041</rd:DataSourceID>
    </DataSource>
  </DataSources>
  <DataSets>
    <DataSet Name="DataSet1">
      <Query>
        <DataSourceName>Planillas</DataSourceName>
        <QueryParameters>
          <QueryParameter Name="@MES_GESTION">
            <Value>=Parameters!MES_GESTION.Value</Value>
          </QueryParameter>
        </QueryParameters>
        <CommandText>SELECT        tbl_mp_tipo_item.ti_tipo_item_gral AS PLANTA_CONTRATO, tbl_mp_tipo_item.ti_tipo, dbo.ObtenerTipoAportante(tbl_pla_boleta_historico.cbh_per_id) AS TIPO_APORTANTE, RTRIM(tbl_persona.per_ap_paterno) 
                         + ' ' + RTRIM(tbl_persona.per_ap_materno) + ' ' + RTRIM(ISNULL(tbl_persona.per_ap_casada, N'')) + ' ' + RTRIM(tbl_persona.per_nombres) AS NOMBRES_COMPLETO, tbl_persona.per_num_doc AS CI, 
                         tbl_mp_escala_salarial.es_descripcion, tbl_mp_escala_salarial.es_escalafon, tbl_pla_boleta_historico.cbh_dias_trab AS pla_dias_trab, tbl_pla_boleta_historico.cbh_anios_sevicio AS CS_ANOS, CONVERT(NVARCHAR(5), 
                         tbl_mp_categoria_programatica.cp_fuente) + '-' + CONVERT(NVARCHAR(5), tbl_mp_categoria_programatica.cp_organismo) AS FUENTE_ORG, tbl_mp_cargo.ca_basico_calculado AS H_BASICO, 
                         SUM(CASE WHEN (DBH.dbh_fa_id IN (61)) THEN DBH.dbh_valor ELSE 0 END) AS HGANADO, SUM(CASE WHEN (DBH.dbh_fa_id IN (24)) THEN DBH.dbh_valor ELSE 0 END) AS BONO_ANT, 
                         SUM(CASE WHEN (DBH.dbh_fa_id IN (43)) THEN DBH.dbh_valor ELSE 0 END) AS BONO_FRONTERA, SUM(CASE WHEN (DBH.dbh_fa_id IN (61, 24, 43)) THEN DBH.dbh_valor ELSE 0 END) AS TOTAL_GANADO, 
                         SUM(CASE WHEN (DBH.dbh_fa_id IN (26, 27, 213, 216, 1004, 1009)) THEN DBH.dbh_valor ELSE 0 END) AS AFP, SUM(CASE WHEN (DBH.dbh_fa_id IN (215, 218,1011)) THEN DBH.dbh_valor ELSE 0 END) AS AFP_NAL, 
                         dbo.ObtenerTotalAporte(tbl_pla_boleta_historico.cbh_per_id) AS AFP_PORCENTAJE, SUM(CASE WHEN (DBH.dbh_fa_id IN (32)) THEN DBH.dbh_valor ELSE 0 END) AS DESC_SINDICAL, SUM(CASE WHEN (DBH.dbh_fa_id IN (999))
                          THEN DBH.dbh_valor ELSE 0 END) AS F_N_T_U_B, SUM(CASE WHEN (DBH.dbh_fa_id IN (57, 58)) THEN DBH.dbh_valor ELSE 0 END) AS ASISTENCIA, SUM(CASE WHEN (DBH.dbh_fa_id IN (51, 52, 54)) 
                         THEN DBH.dbh_valor ELSE 0 END) AS JUDICIAL, SUM(CASE WHEN (DBH.dbh_fa_id IN (100)) THEN DBH.dbh_valor ELSE 0 END) AS IBERIA, SUM(CASE WHEN (DBH.dbh_fa_id IN (101)) THEN DBH.dbh_valor ELSE 0 END) 
                         AS ACRE, SUM(CASE WHEN (F.fa_descripcion LIKE 'CURSOS') THEN DBH.dbh_valor ELSE 0 END) AS CURSOS, SUM(CASE WHEN (F.fa_descripcion NOT LIKE 'CURSOS') AND (F.fa_signo = '-') AND (DBH.dbh_fa_id NOT IN (26, 
                         27, 213, 216, 215, 218, 32, 999, 57, 58, 51, 52, 54, 100, 101, 999,1004,1009,1011)) THEN DBH.dbh_valor ELSE 0 END) AS OTROS, SUM(CASE WHEN (F.fa_signo = '-') THEN DBH.dbh_valor ELSE 0 END) AS T_DESC, 
                         SUM(CASE WHEN (F.fa_signo = '+') THEN DBH.dbh_valor ELSE 0 END) - SUM(CASE WHEN (F.fa_signo = '-') THEN DBH.dbh_valor ELSE 0 END) AS LIQUIDO, tbl_mp_estructura_organizacional.eo_descripcion, 
                         tbl_pla_boleta_historico.cbh_id, tbl_mp_cargo.ca_ti_item + ' ' + CONVERT(NVARCHAR(5), tbl_mp_cargo.ca_num_item) AS ITEM, RTRIM(tbl_puestos.p_descripcion) AS PUESTO, 
                         tbl_mp_primera_asignacion.pasig_fecha_asig AS pla_fecha_alta
FROM            tbl_puestos INNER JOIN
                         tbl_mp_cargo_puesto ON tbl_puestos.p_id = tbl_mp_cargo_puesto.cap_p_id INNER JOIN
                         tbl_pla_boleta_historico INNER JOIN
                         tbl_mp_cargo ON tbl_pla_boleta_historico.cbh_ca_id = tbl_mp_cargo.ca_id INNER JOIN
                         tbl_persona ON tbl_pla_boleta_historico.cbh_per_id = tbl_persona.per_id INNER JOIN
                         tbl_mp_escala_salarial ON tbl_mp_cargo.ca_es_id = tbl_mp_escala_salarial.es_id INNER JOIN
                         tbl_mp_estructura_organizacional ON tbl_mp_cargo.ca_eo_id = tbl_mp_estructura_organizacional.eo_id INNER JOIN
                         tbl_mp_categoria_programatica ON tbl_mp_estructura_organizacional.eo_cp_id = tbl_mp_categoria_programatica.cp_id INNER JOIN
                         General.dbo.tbl_catalogo ON tbl_persona.per_lugar_exp = General.dbo.tbl_catalogo.cat_id INNER JOIN
                         tbl_pla_proceso ON tbl_pla_boleta_historico.cbh_pc_id = tbl_pla_proceso.pc_id INNER JOIN
                         tbl_pla_det_boleta_historico AS DBH ON tbl_pla_boleta_historico.cbh_id = DBH.dbh_cbh_id INNER JOIN
                         tbl_mp_tipo_item ON tbl_mp_tipo_item.ti_item = tbl_mp_cargo.ca_ti_item INNER JOIN
                         tbl_pla_factor AS F ON DBH.dbh_fa_id = F.fa_id INNER JOIN
                         tbl_mp_asignacion AS A ON tbl_pla_boleta_historico.cbh_ca_id = A.as_ca_id AND tbl_pla_boleta_historico.cbh_per_id = A.as_per_id AND A.as_estado &lt;&gt; 'S' ON 
                         tbl_mp_cargo_puesto.cap_ca_id = tbl_mp_cargo.ca_id LEFT OUTER JOIN
                         tbl_mp_primera_asignacion ON tbl_persona.per_id = tbl_mp_primera_asignacion.pasig_per_id
WHERE        (tbl_pla_boleta_historico.cbh_tipo_func = 'ADM') AND (tbl_mp_tipo_item.ti_tipo_item_gral = 'P') AND (tbl_pla_proceso.pc_id = @MES_GESTION) AND (tbl_pla_boleta_historico.cbh_pla_NRO = 0)
GROUP BY tbl_pla_boleta_historico.cbh_per_id, RTRIM(tbl_persona.per_ap_paterno), RTRIM(tbl_persona.per_ap_materno), RTRIM(ISNULL(tbl_persona.per_ap_casada, N'')), RTRIM(tbl_persona.per_nombres), 
                         tbl_persona.per_num_doc + ' ' + General.dbo.tbl_catalogo.cat_abreviacion, tbl_mp_escala_salarial.es_descripcion, tbl_mp_escala_salarial.es_escalafon, tbl_pla_boleta_historico.cbh_dias_trab, 
                         tbl_pla_boleta_historico.cbh_anios_sevicio, tbl_mp_categoria_programatica.cp_fuente, tbl_mp_categoria_programatica.cp_organismo, tbl_mp_cargo.ca_basico_calculado, tbl_mp_tipo_item.ti_tipo_item_gral, 
                         tbl_mp_cargo.ca_basico_calculado, tbl_mp_estructura_organizacional.eo_descripcion, A.as_fecha_inicio, tbl_pla_boleta_historico.cbh_id, tbl_mp_tipo_item.ti_tipo, tbl_mp_cargo.ca_ti_item, CONVERT(NVARCHAR(5), 
                         tbl_mp_cargo.ca_num_item), tbl_puestos.p_descripcion, tbl_persona.per_num_doc, tbl_mp_primera_asignacion.pasig_fecha_asig</CommandText>
      </Query>
      <Fields>
        <Field Name="PLANTA_CONTRATO">
          <DataField>PLANTA_CONTRATO</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="ti_tipo">
