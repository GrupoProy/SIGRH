        </Field>
        <Field Name="cbh_pla_NRO">
          <DataField>cbh_pla_NRO</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
        <Field Name="cp_programa">
          <DataField>cp_programa</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
        <Field Name="cp_proyecto">
          <DataField>cp_proyecto</DataField>
          <rd:TypeName>System.Int64</rd:TypeName>
        </Field>
        <Field Name="cp_actividad">
          <DataField>cp_actividad</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
        <Field Name="cp_descripcion">
          <DataField>cp_descripcion</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="fufi">
          <DataField>fufi</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="PLANTA_CONTRATO">
          <DataField>PLANTA_CONTRATO</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="TIPO_DE_PLANILLA">
          <DataField>TIPO_DE_PLANILLA</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="fa_descripcion">
          <DataField>fa_descripcion</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="dbh_fa_id">
          <DataField>dbh_fa_id</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
        <Field Name="dbh_valor">
          <DataField>dbh_valor</DataField>
          <rd:TypeName>System.Decimal</rd:TypeName>
        </Field>
        <Field Name="S">
          <Value>S</Value>
        </Field>
      </Fields>
    </DataSet>
