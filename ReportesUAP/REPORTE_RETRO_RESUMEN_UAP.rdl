<?xml version="1.0" encoding="utf-8"?>
<Report MustUnderstand="df" xmlns="http://schemas.microsoft.com/sqlserver/reporting/2016/01/reportdefinition" xmlns:rd="http://schemas.microsoft.com/SQLServer/reporting/reportdesigner" xmlns:df="http://schemas.microsoft.com/sqlserver/reporting/2016/01/reportdefinition/defaultfontfamily">
  <df:DefaultFontFamily>Segoe UI</df:DefaultFontFamily>
  <AutoRefresh>0</AutoRefresh>
  <DataSources>
    <DataSource Name="Planillas">
      <DataSourceReference>Planillas</DataSourceReference>
      <rd:SecurityType>None</rd:SecurityType>
      <rd:DataSourceID>c5d34f2d-1766-43a1-8b51-bcd158561de4</rd:DataSourceID>
    </DataSource>
  </DataSources>
  <DataSets>
    <DataSet Name="DataSet1">
      <Query>
        <DataSourceName>Planillas</DataSourceName>
        <CommandText>SELECT       COUNT( DISTINCT tbl_pla_retroactivo_historico.re_per_id) AS CASOS , tbl_pla_retroactivo_historico.re_gestion, 
CASE WHEN tbl_pla_retroactivo_historico.re_tipo = 'ADM' THEN 'ADMINISTRATIVO'
	WHEN tbl_pla_retroactivo_historico.re_tipo = 'DOC' THEN 'DOCENTE'
	WHEN tbl_pla_retroactivo_historico.re_tipo = 'CON' THEN 'CONSULTOR' ELSE '' END AS TIPO_FUNCIONARIO, 
tbl_pla_retroactivo_historico.re_grupo,  tbl_pla_proceso.pc_titulo,
SUM( tbl_pla_retroactivo_historico.re_r_total_ganado) AS TOTAL_GANADO
 FROM            tbl_pla_retroactivo_historico INNER JOIN
                         tbl_pla_proceso ON tbl_pla_retroactivo_historico.re_pc_id = tbl_pla_proceso.pc_id
WHERE        tbl_pla_retroactivo_historico.re_gestion = YEAR(GETDATE()) AND (tbl_pla_retroactivo_historico.re_r_estado = 'V')
GROUP BY tbl_pla_retroactivo_historico.re_gestion, tbl_pla_retroactivo_historico.re_tipo, tbl_pla_retroactivo_historico.re_grupo,  
                          tbl_pla_proceso.pc_titulo</CommandText>
        <rd:UseGenericDesigner>true</rd:UseGenericDesigner>
      </Query>
      <Fields>
        <Field Name="CASOS">
          <DataField>CASOS</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
        <Field Name="re_gestion">
          <DataField>re_gestion</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
        <Field Name="TIPO_FUNCIONARIO">
          <DataField>TIPO_FUNCIONARIO</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="re_grupo">
          <DataField>re_grupo</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="pc_titulo">
          <DataField>pc_titulo</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="TOTAL_GANADO">
          <DataField>TOTAL_GANADO</DataField>
          <rd:TypeName>System.Decimal</rd:TypeName>
        </Field>
      </Fields>
    </DataSet>
  </DataSets>
