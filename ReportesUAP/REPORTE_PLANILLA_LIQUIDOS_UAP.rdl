        <Field Name="prl_total_descuento">
          <DataField>prl_total_descuento</DataField>
          <rd:TypeName>System.Decimal</rd:TypeName>
        </Field>
        <Field Name="prl_total_ganado">
          <DataField>prl_total_ganado</DataField>
