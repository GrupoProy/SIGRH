<?xml version="1.0" encoding="utf-8"?>
<Report MustUnderstand="df" xmlns="http://schemas.microsoft.com/sqlserver/reporting/2016/01/reportdefinition" xmlns:rd="http://schemas.microsoft.com/SQLServer/reporting/reportdesigner" xmlns:df="http://schemas.microsoft.com/sqlserver/reporting/2016/01/reportdefinition/defaultfontfamily">
  <df:DefaultFontFamily>Segoe UI</df:DefaultFontFamily>
  <AutoRefresh>0</AutoRefresh>
  <DataSources>
    <DataSource Name="Planillas">
      <DataSourceReference>Planillas</DataSourceReference>
      <rd:SecurityType>None</rd:SecurityType>
      <rd:DataSourceID>eba10561-6d07-4cd1-86d3-7f0da2e7ac46</rd:DataSourceID>
    </DataSource>
  </DataSources>
  <DataSets>
    <DataSet Name="DataSet1">
      <Query>
        <DataSourceName>Planillas</DataSourceName>
        <QueryParameters>
          <QueryParameter Name="@MES_GESTION">
            <Value>=Parameters!MES_GESTION.Value</Value>
          </QueryParameter>
        </QueryParameters>
        <CommandText>SELECT        prl_cbh_id, prl_tp_id, prl_tipo_abono, case when prl_tipo_abono &lt;&gt;0 then prl_cta else '' end as prl_cta, prl_per_id, prl_ap_paterno, prl_ap_materno, prl_ap_casada, prl_nombres, prl_num_ident, prl_tipo_fun, prl_tipo, prl_titulo, prl_total_descuento, prl_total_ganado, 
                         prl_liquido, prl_orden, prl_estado

FROM            tbl_pla_rep_liquidos
where PRL_TITULO = @MES_GESTION</CommandText>
        <rd:UseGenericDesigner>true</rd:UseGenericDesigner>
      </Query>
      <Fields>
        <Field Name="prl_cbh_id">
          <DataField>prl_cbh_id</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
