        </Field>
        <Field Name="prl_liquido">
          <DataField>prl_liquido</DataField>
          <rd:TypeName>System.Decimal</rd:TypeName>
        </Field>
        <Field Name="prl_orden">
          <DataField>prl_orden</DataField>
