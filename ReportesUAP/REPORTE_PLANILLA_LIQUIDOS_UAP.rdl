    <DataSet Name="DataSet2">
      <Query>
        <DataSourceName>Planillas</DataSourceName>
        <CommandText>SELECT DISTINCT tbl_pla_rep_liquidos.prl_titulo, tbl_pla_proceso.pc_fecha_inicio
FROM            tbl_pla_rep_liquidos INNER JOIN
                         tbl_pla_proceso ON tbl_pla_rep_liquidos.prl_titulo = tbl_pla_proceso.pc_titulo
ORDER BY tbl_pla_proceso.pc_fecha_inicio</CommandText>
      </Query>
      <Fields>
        <Field Name="prl_titulo">
          <DataField>prl_titulo</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="pc_fecha_inicio">
          <DataField>pc_fecha_inicio</DataField>
          <rd:TypeName>System.DateTime</rd:TypeName>
        </Field>
      </Fields>
    </DataSet>
  </DataSets>
