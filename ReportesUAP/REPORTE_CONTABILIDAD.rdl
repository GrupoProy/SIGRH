<?xml version="1.0" encoding="utf-8"?>
<Report MustUnderstand="df" xmlns="http://schemas.microsoft.com/sqlserver/reporting/2016/01/reportdefinition" xmlns:rd="http://schemas.microsoft.com/SQLServer/reporting/reportdesigner" xmlns:df="http://schemas.microsoft.com/sqlserver/reporting/2016/01/reportdefinition/defaultfontfamily">
  <df:DefaultFontFamily>Segoe UI</df:DefaultFontFamily>
  <AutoRefresh>0</AutoRefresh>
  <DataSources>
    <DataSource Name="DataSource1">
      <DataSourceReference>Planillas</DataSourceReference>
      <rd:SecurityType>DataBase</rd:SecurityType>
      <rd:DataSourceID>6fb6fded-4020-4a18-b5e4-02e9727a4abe</rd:DataSourceID>
    </DataSource>
  </DataSources>
  <DataSets>
    <DataSet Name="DataSet1">
      <Query>
        <DataSourceName>DataSource1</DataSourceName>
        <QueryParameters>
          <QueryParameter Name="@CODMES">
            <Value>=Parameters!CODMES.Value</Value>
          </QueryParameter>
          <QueryParameter Name="@NROPLANILLA">
            <Value>=Parameters!NROPLANILLA.Value</Value>
          </QueryParameter>
        </QueryParameters>
        <CommandText>USE sigrh3	
SELECT        

				tbl_pla_proceso.pc_titulo, tbl_pla_boleta_historico.cbh_tipo_func, tbl_pla_boleta_historico.cbh_pla_NRO, CONCAT(tbl_mp_categoria_programatica.cp_programa, ' - ',tbl_mp_categoria_programatica.cp_proyecto,' - ' ,
                         tbl_mp_categoria_programatica.cp_actividad) AS categoria, tbl_mp_categoria_programatica.cp_descripcion,  CONCAT(tbl_mp_categoria_programatica.cp_fuente,' - ' ,
						
                         tbl_mp_categoria_programatica.cp_organismo) AS fufi, tbl_mp_tipo_item.ti_tipo_item_gral AS PLANTA_CONTRATO, 
                         CASE WHEN tbl_tipo_aportante.ta_descripcion = '' THEN 'PLANILLA GENERAL' ELSE RTRIM(tbl_tipo_aportante.ta_descripcion) END AS TIPO_DE_PLANILLA, 
						 SUM(CASE WHEN (DBH.dbh_fa_id IN (61)) THEN DBH.dbh_valor ELSE 0 END) AS HGANADO, 
						 SUM(CASE WHEN (DBH.dbh_fa_id IN (24, 41)) THEN DBH.dbh_valor ELSE 0 END) AS H_ESCALAFON_BONO_ANT, 
						 SUM(CASE WHEN (DBH.dbh_fa_id IN (43)) THEN DBH.dbh_valor ELSE 0 END) AS BONO_FRONTERA, 
						 SUM(CASE WHEN (DBH.dbh_fa_id IN (61, 24, 43, 41)) THEN DBH.dbh_valor ELSE 0 END) AS TOTAL_GANADO, 
						 SUM(CASE WHEN (DBH.dbh_fa_id IN (61, 24, 43, 41) AND tbl_pla_boleta_historico.cbh_afp = 'AF') THEN DBH.dbh_valor ELSE 0 END) AS TOTAL_HG_FUTURO, 
						 SUM(CASE WHEN (DBH.dbh_fa_id IN (61, 24, 43, 41) AND tbl_pla_boleta_historico.cbh_afp = 'AP') THEN DBH.dbh_valor ELSE 0 END) AS TOTAL_HG_PREVISION, 
						 SUM(CASE WHEN (DBH.dbh_fa_id IN (61, 24, 43, 41) AND tbl_pla_boleta_historico.cbh_afp = 'GP') THEN DBH.dbh_valor ELSE 0 END) AS TOTAL_HG_GESTORA, 
						 SUM(CASE WHEN (DBH.dbh_fa_id IN (26, 27, 213, 216,1004,1009)) THEN DBH.dbh_valor ELSE 0 END) AS AFP_LABORAL, 
						 SUM(CASE WHEN (DBH.dbh_fa_id IN (215, 218,1011)) THEN DBH.dbh_valor ELSE 0 END) AS AFP_NAL, 
						 SUM(CASE WHEN (DBH.dbh_fa_id IN (32)) THEN DBH.dbh_valor ELSE 0 END) AS DESC_SINDICAL, 
						 SUM(CASE WHEN (DBH.dbh_fa_id IN (999)) THEN DBH.dbh_valor ELSE 0 END) AS F_N_T_U_B, 
						 SUM(CASE WHEN (DBH.dbh_fa_id IN (57, 58)) THEN DBH.dbh_valor ELSE 0 END) AS ASISTENCIA, 
						 SUM(CASE WHEN (DBH.dbh_fa_id IN (51, 52, 54)) THEN DBH.dbh_valor ELSE 0 END) AS JUDICIAL, 
						 SUM(CASE WHEN (DBH.dbh_fa_id IN (100,101,1003)) THEN DBH.dbh_valor ELSE 0 END) AS CONVENIOS, 
						 SUM(CASE WHEN (DBH.dbh_fa_id IN (1001)) THEN DBH.dbh_valor ELSE 0 END) AS OTROS_FUD, 
						 SUM(CASE WHEN (F.fa_signo = '-') AND (DBH.dbh_fa_id NOT IN (26, 27,1004, 213, 216,1009, 215, 218, 1011, 32, 999, 57, 58, 51, 52, 54, 100, 101, 999, 1001, 1003	)) THEN DBH.dbh_valor ELSE 0 END) AS OTROS, 
						 SUM(CASE WHEN (F.fa_signo = '-') THEN DBH.dbh_valor ELSE 0 END) AS T_DESC, 
						 SUM(CASE WHEN (F.fa_signo = '+') THEN DBH.dbh_valor ELSE 0 END) - SUM(CASE WHEN (F.fa_signo = '-') THEN DBH.dbh_valor ELSE 0 END) AS LIQUIDO, 
                         SUM(CASE WHEN (DBH.dbh_fa_id IN (221)) THEN DBH.dbh_valor ELSE 0 END) AS '13110', 
						 SUM(CASE WHEN (DBH.dbh_fa_id IN (28, 29,1005)) THEN DBH.dbh_valor ELSE 0 END) AS '13120', 
                         SUM(CASE WHEN (DBH.dbh_fa_id IN (217, 214,1010)) THEN DBH.dbh_valor ELSE 0 END) AS '13131', 
						 SUM(CASE WHEN (DBH.dbh_fa_id IN (98, 99, 1008)) THEN DBH.dbh_valor ELSE 0 END) AS '13200', 
                         SUM(CASE WHEN (DBH.dbh_fa_id IN (301)) THEN DBH.dbh_valor ELSE 0 END) AS '301 Renta de Vejez Futuro 10',
						 SUM(CASE WHEN (DBH.dbh_fa_id IN (302)) THEN DBH.dbh_valor ELSE 0 END) AS '302 Renta de Vejez Previsión 10', 
						 SUM(CASE WHEN (DBH.dbh_fa_id IN (1012)) THEN DBH.dbh_valor ELSE 0 END) AS '1012 Renta de Vejez GP 10', --GESTORA PUBLICA
						 SUM(CASE WHEN (DBH.dbh_fa_id IN (303)) THEN DBH.dbh_valor ELSE 0 END) AS '303 Riesgo Común Futuro 1.71', 
						 SUM(CASE WHEN (DBH.dbh_fa_id IN (304)) THEN DBH.dbh_valor ELSE 0 END) AS '304 Riesgo Común Previsión 1.71', 
						 SUM(CASE WHEN (DBH.dbh_fa_id IN (1013)) THEN DBH.dbh_valor ELSE 0 END) AS '10123 Riesgo Común GP 1.71',  --GESTORA PUBLICA
						 SUM(CASE WHEN (DBH.dbh_fa_id IN (305)) THEN DBH.dbh_valor ELSE 0 END) AS '305 Comisión Gastos Administrativos Futuro 0.5', 
                         SUM(CASE WHEN (DBH.dbh_fa_id IN (306)) THEN DBH.dbh_valor ELSE 0 END) AS '306 Comisión Gastos Administrativos Previsión 0.5',
						 SUM(CASE WHEN (DBH.dbh_fa_id IN (1014)) THEN DBH.dbh_valor ELSE 0 END) AS '1014 Comisión Gastos GP 0.5',
						 SUM(CASE WHEN (DBH.dbh_fa_id IN (216)) THEN DBH.dbh_valor ELSE 0 END) AS '324 Aporte Solidario Asegurado Previsión 0.5',
						 SUM(CASE WHEN (DBH.dbh_fa_id IN (213)) THEN DBH.dbh_valor ELSE 0 END) AS '325 Aporte Solidario Asegurado Futuro 0.5',
						 SUM(CASE WHEN (DBH.dbh_fa_id IN (1009)) THEN DBH.dbh_valor ELSE 0 END) AS '1009 Aporte Solidario Asegurado GP 0.5',
						 SUM(CASE WHEN (DBH.dbh_fa_id IN (301, 303, 305, 213)) THEN DBH.dbh_valor ELSE 0 END) AS 'TOTAL FUTURO', 
						 SUM(CASE WHEN (DBH.dbh_fa_id IN (302, 304, 306, 216)) THEN DBH.dbh_valor ELSE 0 END) AS 'TOTAL PREVISION', 
						 SUM(CASE WHEN (DBH.dbh_fa_id IN (1012, 1013, 1014, 1009)) THEN DBH.dbh_valor ELSE 0 END) AS 'TOTAL GESTORA PUBLICA', 
                         SUM(CASE WHEN (DBH.dbh_fa_id IN (215)) THEN DBH.dbh_valor ELSE 0 END) AS '327 Aporte Nacional Solidario Futuro 1',
						 SUM(CASE WHEN (DBH.dbh_fa_id IN (218)) THEN DBH.dbh_valor ELSE 0 END) AS '328 Aporte Nacional Solidario Previsión 1', 
						 SUM(CASE WHEN (DBH.dbh_fa_id IN (1011)) THEN DBH.dbh_valor ELSE 0 END) AS '1011 Aporte Nacional Solidario GP 1', 
						 SUM(CASE WHEN (DBH.dbh_fa_id IN (98)) THEN DBH.dbh_valor ELSE 0 END) AS '74 Provivienda Futuro', 
						 SUM(CASE WHEN (DBH.dbh_fa_id IN (99)) THEN DBH.dbh_valor ELSE 0 END) AS '75 Provivienda Previsión',
						 SUM(CASE WHEN (DBH.dbh_fa_id IN (1008)) THEN DBH.dbh_valor ELSE 0 END) AS '1008 Provivienda GP',
						 SUM(CASE WHEN (DBH.dbh_fa_id IN (28)) THEN DBH.dbh_valor ELSE 0 END) AS '307 Riesgo Profesional Futuro', 
						 SUM(CASE WHEN (DBH.dbh_fa_id IN (29)) THEN DBH.dbh_valor ELSE 0 END) AS '308 Riesgo Profesional Previsión', 
						 SUM(CASE WHEN (DBH.dbh_fa_id IN (1005)) THEN DBH.dbh_valor ELSE 0 END) AS '308 Riesgo Profesional GP', 
						 SUM(CASE WHEN (DBH.dbh_fa_id IN (217)) THEN DBH.dbh_valor ELSE 0 END) AS '320 Aporte Patronal Solidario Previsión', 
                         SUM(CASE WHEN (DBH.dbh_fa_id IN (214)) THEN DBH.dbh_valor ELSE 0 END) AS '321 Aporte Patronal Solidario Futuro', 
						 SUM(CASE WHEN (DBH.dbh_fa_id IN (1010)) THEN DBH.dbh_valor ELSE 0 END) AS '321 Aporte Patronal Solidario GP', 
						 SUM(CASE WHEN (DBH.dbh_fa_id IN (221)) THEN DBH.dbh_valor ELSE 0 END) AS '205 Regimen de Corto Plazo Caja Cordes'
FROM            tbl_tipo_aportante INNER JOIN
                         tbl_mp_asignacion_tipo_aportante ON tbl_tipo_aportante.ta_id = tbl_mp_asignacion_tipo_aportante.at_ta_id INNER JOIN
                         tbl_pla_boleta_historico INNER JOIN
                         tbl_mp_cargo ON tbl_pla_boleta_historico.cbh_ca_id = tbl_mp_cargo.ca_id INNER JOIN
                         tbl_persona ON tbl_pla_boleta_historico.cbh_per_id = tbl_persona.per_id INNER JOIN
                         tbl_mp_escala_salarial ON tbl_mp_cargo.ca_es_id = tbl_mp_escala_salarial.es_id INNER JOIN
                         tbl_mp_estructura_organizacional ON tbl_pla_boleta_historico.cbh_fuente = tbl_mp_estructura_organizacional.eo_id INNER JOIN
                         --tbl_mp_estructura_organizacional ON tbl_mp_cargo.ca_eo_id = tbl_mp_estructura_organizacional.eo_id INNER JOIN
                         tbl_mp_categoria_programatica ON tbl_mp_estructura_organizacional.eo_cp_id = tbl_mp_categoria_programatica.cp_id INNER JOIN
                         general.dbo.tbl_catalogo ON tbl_persona.per_lugar_exp = general.dbo.tbl_catalogo.cat_id INNER JOIN
                         tbl_pla_proceso ON tbl_pla_boleta_historico.cbh_pc_id = tbl_pla_proceso.pc_id INNER JOIN
                         tbl_pla_det_boleta_historico AS DBH ON tbl_pla_boleta_historico.cbh_id = DBH.dbh_cbh_id INNER JOIN
                         tbl_mp_tipo_item ON tbl_mp_tipo_item.ti_item = tbl_mp_cargo.ca_ti_item INNER JOIN
                         tbl_pla_factor AS F ON DBH.dbh_fa_id = F.fa_id INNER JOIN
                         tbl_mp_asignacion AS A ON tbl_pla_boleta_historico.cbh_ca_id = A.as_ca_id AND tbl_pla_boleta_historico.cbh_per_id = A.as_per_id AND A.as_estado &lt;&gt; 'S' ON 
                         tbl_mp_asignacion_tipo_aportante.at_per_id = tbl_pla_boleta_historico.cbh_per_id
WHERE        (tbl_pla_boleta_historico.cbh_tipo_func IN ('ADM', 'DOC')) AND (tbl_mp_asignacion_tipo_aportante.at_estado = 'V') AND (tbl_tipo_aportante.ta_estado = 'V') 
						AND (tbl_pla_proceso.pc_id = @CODMES) AND 
                         (tbl_pla_boleta_historico.cbh_pla_NRO = @NROPLANILLA)
GROUP BY tbl_mp_categoria_programatica.cp_programa, tbl_mp_categoria_programatica.cp_proyecto, tbl_mp_categoria_programatica.cp_actividad, tbl_mp_categoria_programatica.cp_descripcion, 
                         tbl_mp_categoria_programatica.cp_fuente, tbl_mp_categoria_programatica.cp_organismo, tbl_mp_tipo_item.ti_tipo_item_gral, tbl_tipo_aportante.ta_descripcion, tbl_pla_proceso.pc_titulo, tbl_pla_boleta_historico.cbh_pla_NRO, 
                         tbl_pla_boleta_historico.cbh_tipo_func
						
ORDER BY tbl_pla_proceso.pc_titulo, tbl_pla_boleta_historico.cbh_pla_NRO, tbl_mp_categoria_programatica.cp_descripcion</CommandText>
      </Query>
