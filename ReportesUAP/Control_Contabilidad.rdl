        <Field Name="ID303_Riesgo_Común_Futuro_1_71">
          <DataField>303 Riesgo Común Futuro 1.71</DataField>
          <rd:TypeName>System.Decimal</rd:TypeName>
        </Field>
        <Field Name="ID304_Riesgo_Común_Previsión_1_71">
          <DataField>304 Riesgo Común Previsión 1.71</DataField>
          <rd:TypeName>System.Decimal</rd:TypeName>
        </Field>
        <Field Name="ID10123_Riesgo_Común_GP_1_71">
          <DataField>10123 Riesgo Común GP 1.71</DataField>
          <rd:TypeName>System.Decimal</rd:TypeName>
        </Field>
        <Field Name="ID305_Comisión_Gastos_Administrativos_Futuro_0_5">
          <DataField>305 Comisión Gastos Administrativos Futuro 0.5</DataField>
          <rd:TypeName>System.Decimal</rd:TypeName>
