          <rd:TypeName>System.Decimal</rd:TypeName>
        </Field>
        <Field Name="LIQUIDO">
          <DataField>LIQUIDO</DataField>
          <rd:TypeName>System.Decimal</rd:TypeName>
        </Field>
        <Field Name="ID13110">
