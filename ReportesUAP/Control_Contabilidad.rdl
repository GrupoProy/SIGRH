        </Field>
        <Field Name="TOTAL_GESTORA_PUBLICA">
          <DataField>TOTAL GESTORA PUBLICA</DataField>
          <rd:TypeName>System.Decimal</rd:TypeName>
        </Field>
        <Field Name="ID327_Aporte_Nacional_Solidario_Futuro_1">
          <DataField>327 Aporte Nacional Solidario Futuro 1</DataField>
          <rd:TypeName>System.Decimal</rd:TypeName>
        </Field>
        <Field Name="ID328_Aporte_Nacional_Solidario_Previsión_1">
          <DataField>328 Aporte Nacional Solidario Previsión 1</DataField>
          <rd:TypeName>System.Decimal</rd:TypeName>
        </Field>
        <Field Name="ID1011_Aporte_Nacional_Solidario_GP_1">
          <DataField>1011 Aporte Nacional Solidario GP 1</DataField>
          <rd:TypeName>System.Decimal</rd:TypeName>
        </Field>
        <Field Name="ID74_Provivienda_Futuro">
          <DataField>74 Provivienda Futuro</DataField>
          <rd:TypeName>System.Decimal</rd:TypeName>
        </Field>
        <Field Name="ID75_Provivienda_Previsión">
