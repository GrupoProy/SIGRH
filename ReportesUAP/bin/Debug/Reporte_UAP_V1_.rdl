<?xml version="1.0" encoding="utf-8"?>
<Report MustUnderstand="df" xmlns="http://schemas.microsoft.com/sqlserver/reporting/2016/01/reportdefinition" xmlns:rd="http://schemas.microsoft.com/SQLServer/reporting/reportdesigner" xmlns:df="http://schemas.microsoft.com/sqlserver/reporting/2016/01/reportdefinition/defaultfontfamily">
  <df:DefaultFontFamily>Segoe UI</df:DefaultFontFamily>
  <AutoRefresh>0</AutoRefresh>
  <DataSources>
    <DataSource Name="Planillas">
      <DataSourceReference>Planillas</DataSourceReference>
      <rd:SecurityType>None</rd:SecurityType>
      <rd:DataSourceID>25cdecc9-95ce-4ea8-9580-8eb33be0c27e</rd:DataSourceID>
    </DataSource>
  </DataSources>
  <DataSets>
    <DataSet Name="DataSet1">
      <Query>
        <DataSourceName>Planillas</DataSourceName>
        <CommandText>SELECT     tbl_mp_tipo_item.ti_tipo_item_gral AS PLANTA_CONTRATO, 
dbo.ObtenerTipoAportante(tbl_pla_temp_func_sueldo.pla_per_id) as TIPO_APORTANTE,
tbl_pla_temp_func_sueldo.pla_fecha_alta, RTRIM(tbl_persona.per_ap_paterno) + ' ' + RTRIM(tbl_persona.per_ap_materno) + ' ' + RTRIM(ISNULL(tbl_persona.per_ap_casada, N'')) 
                         + ' ' + RTRIM(tbl_persona.per_nombres) AS NOMBRES_COMPLETO, tbl_persona.per_num_doc + ' ' + General.dbo.tbl_catalogo.cat_abreviacion AS CI, tbl_mp_escala_salarial.es_descripcion, 
                         tbl_mp_escala_salarial.es_escalafon, tbl_pla_temp_func_sueldo.pla_dias_trab, tbl_pla_cas.cs_anos, CONVERT(NVARCHAR(5), tbl_mp_categoria_programatica.cp_fuente) + '-' + CONVERT(NVARCHAR(5), 
                         tbl_mp_categoria_programatica.cp_organismo) AS FUENTE_ORG, tbl_pla_temp_func_sueldo.pla_hbasico AS H_BASICO, ROUND(tbl_pla_temp_func_sueldo.pla_hbasico / 30 * tbl_pla_temp_func_sueldo.pla_dias_trab, 2) 
                         AS H_GANADO,
						 ISNULL(dbo.ObtenerBono(tbl_pla_cas.cs_anos, (SELECT SM.sm_importe*3 FROM [sigrh3].[dbo].[tbl_salarios_minimos] SM WHERE SM.sm_estado = 'V' AND SM.sm_operacion = 'P')), 0) AS BONO_ANT,
						 CONVERT(FLOAT, ROUND(tbl_pla_temp_func_sueldo.pla_hbasico * 0.20, 2)) AS BONO_FRONTERA, 
                         ROUND(tbl_pla_temp_func_sueldo.pla_hbasico / 30 * tbl_pla_temp_func_sueldo.pla_dias_trab, 2) + ISNULL(dbo.ObtenerBono(tbl_pla_cas.cs_anos, (SELECT SM.sm_importe*3 FROM [sigrh3].[dbo].[tbl_salarios_minimos] SM WHERE SM.sm_estado = 'V' AND SM.sm_operacion = 'P')), 0) + CONVERT(FLOAT, 
                         ROUND(tbl_pla_temp_func_sueldo.pla_hbasico * 0.20, 2)) AS TOTAL_GANADO, 
						 
						 dbo.ObtenerTotalAporte(tbl_pla_temp_func_sueldo.pla_per_id) AS AFP_LABORAL, 
                         SUM(CASE WHEN tbl_pla_transacciones.tr_fa_id = 32 THEN 100 ELSE 0 END) AS DES_SINDICAL, SUM(CASE WHEN tbl_pla_transacciones.tr_fa_id = 999 THEN tbl_pla_factor.fa_valor ELSE 0 END) AS [F.N.T.U.B.], 
                         SUM(CASE WHEN tbl_pla_transacciones.tr_fa_id = 103 THEN tbl_pla_transacciones.tr_monto ELSE 0 END) AS ASISTENCIA, 
                         SUM(CASE WHEN tbl_pla_transacciones.tr_fa_id = 102 THEN tbl_pla_transacciones.tr_monto ELSE 0 END) AS [OTRO FONDO EN AVANCE], 
                         SUM(CASE WHEN tbl_pla_transacciones.tr_fa_id = 100 THEN tbl_pla_transacciones.tr_monto ELSE 0 END) AS IBERIA, SUM(CASE WHEN tbl_pla_transacciones.tr_fa_id = 101 THEN tbl_pla_transacciones.tr_monto ELSE 0 END) 
                         AS ACRE, tbl_mp_estructura_organizacional.eo_descripcion
FROM            tbl_mp_tipo_item INNER JOIN
                         tbl_pla_temp_func_sueldo INNER JOIN
                         tbl_persona ON tbl_pla_temp_func_sueldo.pla_per_id = tbl_persona.per_id INNER JOIN
                         tbl_mp_cargo ON tbl_pla_temp_func_sueldo.pla_ca_id = tbl_mp_cargo.ca_id INNER JOIN
                         tbl_mp_escala_salarial ON tbl_mp_cargo.ca_es_id = tbl_mp_escala_salarial.es_id INNER JOIN
                         tbl_mp_estructura_organizacional ON tbl_mp_cargo.ca_eo_id = tbl_mp_estructura_organizacional.eo_id INNER JOIN
                         tbl_mp_categoria_programatica ON tbl_mp_estructura_organizacional.eo_cp_id = tbl_mp_categoria_programatica.cp_id INNER JOIN
                         General.dbo.tbl_catalogo ON tbl_persona.per_lugar_exp = General.dbo.tbl_catalogo.cat_id ON tbl_mp_tipo_item.ti_item = tbl_mp_cargo.ca_ti_item LEFT OUTER JOIN
                         tbl_pla_factor INNER JOIN
                         tbl_pla_transacciones ON tbl_pla_factor.fa_id = tbl_pla_transacciones.tr_fa_id ON tbl_pla_temp_func_sueldo.pla_per_id = tbl_pla_transacciones.tr_per_id AND tbl_pla_transacciones.tr_estado = 'V' LEFT OUTER JOIN
                         tbl_pla_cas ON tbl_pla_temp_func_sueldo.pla_per_id = tbl_pla_cas.cs_per_id AND tbl_pla_cas.cs_estado = 'V'
WHERE EO_PROG=11
GROUP BY tbl_pla_temp_func_sueldo.pla_fecha_alta, RTRIM(tbl_persona.per_ap_paterno), RTRIM(tbl_persona.per_ap_materno), RTRIM(ISNULL(tbl_persona.per_ap_casada, N'')), RTRIM(tbl_persona.per_nombres), 
                         tbl_persona.per_num_doc, General.dbo.tbl_catalogo.cat_abreviacion, tbl_mp_escala_salarial.es_descripcion, tbl_mp_escala_salarial.es_escalafon, tbl_pla_temp_func_sueldo.pla_dias_trab, tbl_pla_cas.cs_anos, 
                         tbl_pla_temp_func_sueldo.pla_hbasico, CONVERT(NVARCHAR(5), tbl_mp_categoria_programatica.cp_fuente) + '-' + CONVERT(NVARCHAR(5), tbl_mp_categoria_programatica.cp_organismo), 
                         tbl_pla_temp_func_sueldo.pla_per_id, tbl_pla_transacciones.tr_fa_id, tbl_mp_tipo_item.ti_tipo_item_gral,  tbl_mp_estructura_organizacional.eo_descripcion</CommandText>
        <rd:UseGenericDesigner>true</rd:UseGenericDesigner>
      </Query>
