        </Field>
        <Field Name="DES_SINDICAL">
          <DataField>DES_SINDICAL</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
        <Field Name="F_N_T_U_B_">
          <DataField>F.N.T.U.B.</DataField>
          <rd:TypeName>System.Decimal</rd:TypeName>
        </Field>
        <Field Name="ASISTENCIA">
          <DataField>ASISTENCIA</DataField>
          <rd:TypeName>System.Decimal</rd:TypeName>
        </Field>
        <Field Name="OTRO_FONDO_EN_AVANCE">
          <DataField>OTRO FONDO EN AVANCE</DataField>
          <rd:TypeName>System.Decimal</rd:TypeName>
        </Field>
        <Field Name="IBERIA">
