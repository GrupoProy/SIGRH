        </Field>
      </Fields>
    </DataSet>
    <DataSet Name="DataSet2">
      <Query>
        <DataSourceName>Planillas</DataSourceName>
        <CommandText>SELECT       pc_pr_id, pc_titulo
FROM            tbl_pla_proceso
WHERE        (pc_estado = 'V')</CommandText>
      </Query>
      <Fields>
        <Field Name="pc_pr_id">
          <DataField>pc_pr_id</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
        <Field Name="pc_titulo">
          <DataField>pc_titulo</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
      </Fields>
    </DataSet>
  </DataSets>
