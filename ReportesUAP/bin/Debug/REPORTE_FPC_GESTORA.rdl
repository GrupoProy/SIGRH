<?xml version="1.0" encoding="utf-8"?>
<Report MustUnderstand="df" xmlns="http://schemas.microsoft.com/sqlserver/reporting/2016/01/reportdefinition" xmlns:rd="http://schemas.microsoft.com/SQLServer/reporting/reportdesigner" xmlns:df="http://schemas.microsoft.com/sqlserver/reporting/2016/01/reportdefinition/defaultfontfamily">
  <df:DefaultFontFamily>Segoe UI</df:DefaultFontFamily>
  <AutoRefresh>0</AutoRefresh>
  <DataSources>
    <DataSource Name="DataSource13">
      <ConnectionProperties>
        <DataProvider>SQL</DataProvider>
        <ConnectString>Data Source=localhost;Initial Catalog=sigrh3</ConnectString>
        <IntegratedSecurity>true</IntegratedSecurity>
      </ConnectionProperties>
      <rd:SecurityType>Integrated</rd:SecurityType>
      <rd:DataSourceID>4a2e4163-ec59-498d-856e-c16c05c20bc8</rd:DataSourceID>
    </DataSource>
  </DataSources>
  <DataSets>
    <DataSet Name="DataSet1">
      <Query>
        <DataSourceName>DataSource13</DataSourceName>
        <QueryParameters>
          <QueryParameter Name="@MES_GESTION">
            <Value>=Parameters!MES_GESTION.Value</Value>
            <rd:UserDefined>true</rd:UserDefined>
          </QueryParameter>
          <QueryParameter Name="@NRO_PLANILLA">
            <Value>=Parameters!NRO_PLANILLA.Value</Value>
            <rd:UserDefined>true</rd:UserDefined>
          </QueryParameter>
        </QueryParameters>
        <CommandText>/*AFP FUTURO*/
USE sigrh3
SELECT        'CI' AS '(13) TIPO', tbl_persona.per_num_doc AS '(14) No', General.dbo.tbl_catalogo.cat_abreviacion AS '(14) EXTENSIÓN', dbo.ObtenerAFP_NUA(tbl_pla_boleta_historico.cbh_per_id) AS '(15) NUA/CUA', 
                         RTRIM(tbl_persona.per_ap_paterno) AS '(A) 1er. APELLIDO (PATERNO)', RTRIM(tbl_persona.per_ap_materno) AS '(B) 2do. APELLIDO (MATERNO)', RTRIM(ISNULL(tbl_persona.per_ap_casada, N'')) AS '(C) APELLIDO CASADA', 
                         CASE WHEN CHARINDEX(' ', tbl_persona.per_nombres) = 0 THEN tbl_persona.per_nombres ELSE SUBSTRING(tbl_persona.per_nombres, 1, CHARINDEX(' ', tbl_persona.per_nombres) - 1) END AS '(D) PRIMER NOMBRE', 
                         CASE WHEN CHARINDEX(' ', tbl_persona.per_nombres) = 0 THEN '' ELSE LTRIM(RTRIM(SUBSTRING(tbl_persona.per_nombres, CHARINDEX(' ', tbl_persona.per_nombres) + 1, LEN(tbl_persona.per_nombres)))) 
                         END AS '(E) SEGUNDO NOMBRE', 'PANDO' AS '(F) DEPARTAMENTO', CASE WHEN (ISNULL(PA.pasig_fecha_asig, DBO.fn_Fecha_Ingreso(tbl_pla_boleta_historico.CBH_per_id, A.as_fecha_inicio))) BETWEEN pc_fecha_inicio AND
                          pc_fecha_fin THEN 'I' ELSE (CASE WHEN A.as_fecha_fin BETWEEN pc_fecha_inicio AND pc_fecha_fin THEN 'R' ELSE '' END) END AS '(17) NOVEDAD I/R/L/S', 
						  
						  CASE WHEN (ISNULL(PA.pasig_fecha_asig, DBO.fn_Fecha_Ingreso(tbl_pla_boleta_historico.CBH_per_id, A.as_fecha_inicio))) BETWEEN pc_fecha_inicio AND pc_fecha_fin THEN 
						  CONVERT(varchar(12),ISNULL(PA.pasig_fecha_asig, DBO.fn_Fecha_Ingreso(tbl_pla_boleta_historico.CBH_per_id, A.as_fecha_inicio)),103) 
						  ELSE 
						  (CASE WHEN A.as_fecha_fin BETWEEN pc_fecha_inicio AND pc_fecha_fin THEN CONVERT(varchar(12),A.as_fecha_fin, 103) ELSE '' END) END AS '(18) FECHA NOVEDAD dd/mm/aaaa', 

                         tbl_pla_boleta_historico.cbh_dias_trab AS '(19) DIAS COTIZADOS', CASE WHEN dbo.ObtenerTipoAportante_TA_ID(tbl_pla_boleta_historico.CBH_per_id) 
                         = 1 THEN '' WHEN dbo.ObtenerTipoAportante_TA_ID(tbl_pla_boleta_historico.CBH_per_id) = 2 THEN 'M' WHEN dbo.ObtenerTipoAportante_TA_ID(tbl_pla_boleta_historico.CBH_per_id) IN (5, 7, 9) 
                         THEN 'C' ELSE '' END AS '(20) TIPO DE ASEGURADO (M/C/E)', CAST(CASE WHEN dbo.ObtenerTipoAportante_TA_ID(tbl_pla_boleta_historico.CBH_per_id) IN (1, 3, 7) THEN SUM(CASE WHEN (DBH.dbh_fa_id IN (61, 24, 43, 41)) 
                         THEN DBH.dbh_valor ELSE 0 END) ELSE 0 END AS NVARCHAR) AS '(21) DEP&lt;65 O ASEG&lt;65 SI APORTA', CAST(CASE WHEN dbo.ObtenerTipoAportante_TA_ID(tbl_pla_boleta_historico.CBH_per_id) IN (2, 4, 8) 
                         THEN SUM(CASE WHEN (DBH.dbh_fa_id IN (61, 24, 43, 41)) THEN DBH.dbh_valor ELSE 0 END) ELSE 0 END AS NVARCHAR) AS '(22) DEP&gt;65 O ASEG&gt;65 SI APORTA', 
                         CAST(CASE WHEN dbo.ObtenerTipoAportante_TA_ID(tbl_pla_boleta_historico.CBH_per_id) IN (5, 9) THEN SUM(CASE WHEN (DBH.dbh_fa_id IN (61, 24, 43, 41)) THEN DBH.dbh_valor ELSE 0 END) ELSE 0 END AS NVARCHAR) 
                         AS '(23) ASEG&lt;65 NO APORTA', CAST(CASE WHEN dbo.ObtenerTipoAportante_TA_ID(tbl_pla_boleta_historico.CBH_per_id) IN (6, 10) THEN SUM(CASE WHEN (DBH.dbh_fa_id IN (61, 24, 43, 41)) THEN DBH.dbh_valor ELSE 0 END)
                          ELSE 0 END AS NVARCHAR) AS '(24) ASEG&gt;65 NO APORTA', '' AS '(25) COTIZACION ADICIONAL', CAST(SUM(CASE WHEN (DBH.dbh_fa_id IN (61, 24, 43, 41)) THEN DBH.dbh_valor ELSE 0 END) AS NVARCHAR) 
                         AS '(26) PROVIVIENDA', CAST(SUM(CASE WHEN (DBH.dbh_fa_id IN (61, 24, 43, 41)) THEN DBH.dbh_valor ELSE 0 END) AS NVARCHAR) AS '(27) FONDO SOLIDARIO', '' AS 'ID 28 TOTAL GANADO FONDO SOLIDARIO MINERO', 
                         tbl_pla_boleta_historico.cbh_tipo_func, tbl_mp_tipo_item.ti_tipo_item_gral AS PLANTA_CONTRATO, dbo.ObtenerTipoAportante(tbl_pla_boleta_historico.cbh_per_id) AS TIPO_APORTANTE, 
                         SUM(CASE WHEN (DBH.dbh_fa_id IN (26, 27, 213, 216)) THEN DBH.dbh_valor ELSE 0 END) AS AFP, SUM(CASE WHEN (DBH.dbh_fa_id IN (215, 218)) THEN DBH.dbh_valor ELSE 0 END) AS AFP_NAL, 
                         dbo.ObtenerTotalAporte(tbl_pla_boleta_historico.cbh_per_id) AS AFP_PORCENTAJE, tbl_mp_cargo.ca_ti_item + ' ' + CONVERT(NVARCHAR(6), tbl_mp_cargo.ca_num_item) AS ITEM, tbl_mp_categoria_programatica.cp_programa, 
                         tbl_mp_categoria_programatica.cp_proyecto, tbl_mp_categoria_programatica.cp_actividad, tbl_mp_categoria_programatica.cp_descripcion, tbl_mp_categoria_programatica.cp_fuente, 
                         tbl_mp_categoria_programatica.cp_organismo, tbl_mp_tipo_item.ti_descripcion
FROM            tbl_pla_boleta_historico INNER JOIN
                         tbl_mp_cargo ON tbl_pla_boleta_historico.cbh_ca_id = tbl_mp_cargo.ca_id INNER JOIN
                         tbl_persona ON tbl_pla_boleta_historico.cbh_per_id = tbl_persona.per_id INNER JOIN
                         tbl_mp_escala_salarial ON tbl_mp_cargo.ca_es_id = tbl_mp_escala_salarial.es_id INNER JOIN
                         tbl_mp_estructura_organizacional ON tbl_mp_cargo.ca_eo_id = tbl_mp_estructura_organizacional.eo_id INNER JOIN
                         tbl_mp_categoria_programatica ON tbl_mp_estructura_organizacional.eo_cp_id = tbl_mp_categoria_programatica.cp_id INNER JOIN
                         General.dbo.tbl_catalogo ON tbl_persona.per_lugar_exp = General.dbo.tbl_catalogo.cat_id INNER JOIN
                         tbl_pla_proceso ON tbl_pla_boleta_historico.cbh_pc_id = tbl_pla_proceso.pc_id INNER JOIN
                         tbl_pla_det_boleta_historico AS DBH ON tbl_pla_boleta_historico.cbh_id = DBH.dbh_cbh_id INNER JOIN
                         tbl_mp_tipo_item ON tbl_mp_tipo_item.ti_item = tbl_mp_cargo.ca_ti_item INNER JOIN
                         tbl_pla_factor AS F ON DBH.dbh_fa_id = F.fa_id INNER JOIN
                         tbl_mp_asignacion AS A ON tbl_pla_boleta_historico.cbh_ca_id = A.as_ca_id AND tbl_pla_boleta_historico.cbh_per_id = A.as_per_id AND A.as_estado &lt;&gt; 'S' LEFT OUTER JOIN
                         tbl_mp_primera_asignacion AS pa ON pa.pasig_per_id = A.as_per_id
WHERE        (tbl_pla_boleta_historico.cbh_pla_NRO = @NRO_PLANILLA) AND (tbl_pla_boleta_historico.cbh_tipo_func &lt;&gt; 'CON') AND (tbl_pla_proceso.pc_id = @MES_GESTION) AND (dbo.ObtenerAFP(tbl_pla_boleta_historico.cbh_per_id) = 'GP')

GROUP BY tbl_pla_boleta_historico.cbh_per_id, RTRIM(tbl_persona.per_ap_paterno), RTRIM(tbl_persona.per_ap_materno), RTRIM(ISNULL(tbl_persona.per_ap_casada, N'')), RTRIM(tbl_persona.per_nombres), 
                         tbl_persona.per_num_doc + ' ' + General.dbo.tbl_catalogo.cat_abreviacion, tbl_mp_escala_salarial.es_descripcion, tbl_mp_escala_salarial.es_escalafon, tbl_pla_boleta_historico.cbh_dias_trab, 
                         tbl_pla_boleta_historico.cbh_anios_sevicio, tbl_mp_categoria_programatica.cp_fuente, tbl_mp_categoria_programatica.cp_organismo, tbl_mp_cargo.ca_basico_calculado, tbl_mp_tipo_item.ti_tipo_item_gral, 
                         tbl_mp_cargo.ca_basico_calculado, tbl_mp_estructura_organizacional.eo_descripcion, A.as_fecha_inicio, tbl_mp_cargo.ca_ti_item + ' ' + CONVERT(NVARCHAR(6), tbl_mp_cargo.ca_num_item), 
                         tbl_pla_boleta_historico.cbh_ca_id, tbl_persona.per_num_doc, General.dbo.tbl_catalogo.cat_abreviacion, tbl_pla_boleta_historico.cbh_tipo_func, pa.pasig_fecha_asig, tbl_pla_proceso.pc_fecha_inicio, 
                         tbl_pla_proceso.pc_fecha_fin, A.as_fecha_fin, tbl_persona.per_nombres, tbl_persona.per_ap_paterno, tbl_persona.per_ap_materno, tbl_mp_categoria_programatica.cp_programa, tbl_mp_categoria_programatica.cp_proyecto, 
                         tbl_mp_categoria_programatica.cp_actividad, tbl_mp_categoria_programatica.cp_descripcion, tbl_mp_tipo_item.ti_descripcion</CommandText>
      </Query>
