<?xml version="1.0" encoding="utf-8"?>
<Report MustUnderstand="df" xmlns="http://schemas.microsoft.com/sqlserver/reporting/2016/01/reportdefinition" xmlns:rd="http://schemas.microsoft.com/SQLServer/reporting/reportdesigner" xmlns:df="http://schemas.microsoft.com/sqlserver/reporting/2016/01/reportdefinition/defaultfontfamily">
  <df:DefaultFontFamily>Segoe UI</df:DefaultFontFamily>
  <AutoRefresh>0</AutoRefresh>
  <DataSources>
    <DataSource Name="Planillas">
      <DataSourceReference>Planillas</DataSourceReference>
      <rd:SecurityType>None</rd:SecurityType>
      <rd:DataSourceID>fe7fe0ee-44ef-47e0-946c-b679929e449a</rd:DataSourceID>
    </DataSource>
  </DataSources>
  <DataSets>
    <DataSet Name="DataSet1">
      <Query>
        <DataSourceName>Planillas</DataSourceName>
        <QueryParameters>
          <QueryParameter Name="@cod_persona3">
            <Value>=Parameters!cod_persona3.Value</Value>
          </QueryParameter>
        </QueryParameters>
        <CommandText>SELECT        TOP (1) vac_id, vac_per_id, vac_a_partir, vac_hasta, vac_va_id, vac_nro_dias_vacacion, vac_observacion, 
dbo.NumeroLiteral(vac_nro_dias_vacacion) as dias_literal,vac_motivo_anulado, vac_fecha_anulado, vac_correlativo, vac_usuario_creacion,FORMAT(vac_fecha_creacion, 'dd/MM/yyyy') as vac_fecha_creacion, 
vac_lj_id,CONCAT(RTRIM(LTRIM(P.per_nombres)), ' ', RTRIM(LTRIM(P.per_ap_paterno)), ' ', RTRIM(LTRIM(P.per_ap_materno)), ' ') AS nombre_autoriza,
RTRIM(ES.es_descripcion) AS CARGO_AUTORIZA, RTRIM(EO.eo_descripcion) AS UNIDAD
FROM            tbl_kd_solicitud_vacacion INNER  JOIN
tbl_mp_asignacion A ON A.as_per_id = tbl_kd_solicitud_vacacion.vac_per_id AND A.as_estado ='V'JOIN
tbl_mp_cargo C ON A.as_ca_id = C.ca_id INNER JOIN
tbl_mp_estructura_organizacional EO ON C.ca_eo_id = EO.eo_id INNER JOIN
tbl_mp_escala_salarial ES ON C.ca_es_id= ES.es_id INNER JOIN
tbl_mp_tipo_item T ON C.ca_ti_item = T.ti_item and T.ti_tipo ='ADM' INNER JOIN
tbl_persona P ON P.per_id = tbl_kd_solicitud_vacacion.vac_per_id
WHERE        (vac_per_id = @cod_persona3) AND (vac_estado = 'V')
ORDER BY vac_id DESC</CommandText>
        <rd:UseGenericDesigner>true</rd:UseGenericDesigner>
      </Query>
      <Fields>
        <Field Name="vac_id">
          <DataField>vac_id</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
        <Field Name="vac_per_id">
          <DataField>vac_per_id</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
        <Field Name="vac_a_partir">
          <DataField>vac_a_partir</DataField>
          <rd:TypeName>System.DateTime</rd:TypeName>
        </Field>
        <Field Name="vac_hasta">
          <DataField>vac_hasta</DataField>
          <rd:TypeName>System.DateTime</rd:TypeName>
        </Field>
        <Field Name="vac_va_id">
          <DataField>vac_va_id</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="vac_nro_dias_vacacion">
          <DataField>vac_nro_dias_vacacion</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="vac_observacion">
          <DataField>vac_observacion</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="dias_literal">
          <DataField>dias_literal</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="vac_motivo_anulado">
          <DataField>vac_motivo_anulado</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="vac_fecha_anulado">
          <DataField>vac_fecha_anulado</DataField>
          <rd:TypeName>System.DateTime</rd:TypeName>
        </Field>
        <Field Name="vac_correlativo">
          <DataField>vac_correlativo</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
        <Field Name="vac_usuario_creacion">
          <DataField>vac_usuario_creacion</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
        <Field Name="vac_fecha_creacion">
          <DataField>vac_fecha_creacion</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="vac_lj_id">
          <DataField>vac_lj_id</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
        <Field Name="nombre_autoriza">
          <DataField>nombre_autoriza</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="CARGO_AUTORIZA">
          <DataField>CARGO_AUTORIZA</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="UNIDAD">
          <DataField>UNIDAD</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
      </Fields>
    </DataSet>
  </DataSets>
