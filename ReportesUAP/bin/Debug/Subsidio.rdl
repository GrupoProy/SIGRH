  <DataSets>
    <DataSet Name="DataSet1">
      <Query>
        <DataSourceName>DataSource1</DataSourceName>
        <QueryParameters>
          <QueryParameter Name="@pc_id">
            <Value>=Parameters!pc_id.Value</Value>
          </QueryParameter>
        </QueryParameters>
        <CommandText>SELECT    pc_titulo
FROM    tbl_pla_proceso
WHERE    pc_id  =   @pc_id

</CommandText>
      </Query>
      <Fields>
        <Field Name="pc_titulo">
          <DataField>pc_titulo</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
      </Fields>
    </DataSet>
    <DataSet Name="DataSet2">
      <Query>
        <DataSourceName>DataSource1</DataSourceName>
        <QueryParameters>
          <QueryParameter Name="@per_id">
            <Value>=Parameters!per_id.Value</Value>
          </QueryParameter>
        </QueryParameters>
        <CommandText>SELECT CASE WHEN per_sexo = 'M' THEN ' HOMBRES  ( 1 )' ELSE ' HOMBRES  (  )' END AS hombres, CASE WHEN per_sexo = 'F' THEN ' MUJERES  ( 1 )' ELSE ' MUJERES  (  )' END AS mujeres
FROM tbl_persona
WHERE per_id = @per_id</CommandText>
      </Query>
      <Fields>
        <Field Name="hombres">
          <DataField>hombres</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="mujeres">
          <DataField>mujeres</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
      </Fields>
    </DataSet>
    <DataSet Name="Grid">
