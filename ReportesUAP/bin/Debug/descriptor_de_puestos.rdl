<?xml version="1.0" encoding="utf-8"?>
<Report MustUnderstand="df" xmlns="http://schemas.microsoft.com/sqlserver/reporting/2016/01/reportdefinition" xmlns:rd="http://schemas.microsoft.com/SQLServer/reporting/reportdesigner" xmlns:df="http://schemas.microsoft.com/sqlserver/reporting/2016/01/reportdefinition/defaultfontfamily">
  <df:DefaultFontFamily>Segoe UI</df:DefaultFontFamily>
  <AutoRefresh>0</AutoRefresh>
  <DataSources>
    <DataSource Name="DataSource1">
      <ConnectionProperties>
        <DataProvider>SQL</DataProvider>
        <ConnectString>Data Source=virtual.uap.edu.bo;Initial Catalog=sigrh3</ConnectString>
      </ConnectionProperties>
      <rd:SecurityType>DataBase</rd:SecurityType>
      <rd:DataSourceID>2d43eed6-2d9d-441b-90a7-5e3af3a1bd75</rd:DataSourceID>
    </DataSource>
  </DataSources>
  <DataSets>
    <DataSet Name="DataSet1">
      <Query>
        <DataSourceName>DataSource1</DataSourceName>
        <QueryParameters>
          <QueryParameter Name="@desc_id">
            <Value>=Parameters!desc_id.Value</Value>
          </QueryParameter>
        </QueryParameters>
        <CommandText>SELECT        tbl_persona.per_ap_paterno, tbl_persona.per_ap_materno, tbl_persona.per_nombres, tbl_persona.per_num_doc, tbl_persona.per_id, convert(date,tbl_mp_asignacion.as_fecha_inicio) as as_fecha_inicio, convert(date,tbl_mp_asignacion.as_fecha_fin) as as_fecha_fin, 
                         tbl_mp_cargo.ca_ti_item, tbl_mp_cargo.ca_num_item, tbl_mp_escala_salarial.es_descripcion, tbl_mp_escala_salarial.es_ne_id, tbl_puestos.p_descripcion, tbl_mp_descriptor_puestos.descrip_pu_objetivo, 
                         tbl_mp_descriptor_puestos_resultados.result_tipo, tbl_mp_descriptor_puestos_resultados.result_resultado, tbl_mp_descriptor_puestos_resultados.result_ponderacion, tbl_requisito_formacion.rf_formacion, 
                         tbl_requisito_formacion.rf_exp_gral, tbl_requisito_formacion.rf_exp_esp, tbl_mp_estructura_organizacional.eo_descripcion
FROM            tbl_mp_descriptor_puestos INNER JOIN
                         tbl_mp_descriptor_puestos_resultados ON tbl_mp_descriptor_puestos.descrip_pu_id = tbl_mp_descriptor_puestos_resultados.descrip_pu_id INNER JOIN
                         tbl_puestos INNER JOIN
                         tbl_mp_cargo_puesto ON tbl_puestos.p_id = tbl_mp_cargo_puesto.cap_p_id INNER JOIN
                         tbl_requisito_formacion INNER JOIN
                         tbl_mp_escala_salarial ON tbl_requisito_formacion.rf_id = tbl_mp_escala_salarial.es_rf_id INNER JOIN
                         tbl_persona INNER JOIN
                         tbl_mp_asignacion ON tbl_persona.per_id = tbl_mp_asignacion.as_per_id INNER JOIN
                         tbl_mp_cargo ON tbl_mp_asignacion.as_ca_id = tbl_mp_cargo.ca_id ON tbl_mp_escala_salarial.es_id = tbl_mp_cargo.ca_es_id ON tbl_mp_cargo_puesto.cap_ca_id = tbl_mp_cargo.ca_id ON 
                         tbl_mp_descriptor_puestos.descrip_pu_ca_id = tbl_mp_cargo.ca_id INNER JOIN
                         tbl_mp_estructura_organizacional ON tbl_mp_cargo.ca_eo_id = tbl_mp_estructura_organizacional.eo_id
WHERE        (tbl_mp_asignacion.as_estado = 'V') AND tbl_mp_descriptor_puestos.descrip_pu_id = @desc_id</CommandText>
      </Query>
