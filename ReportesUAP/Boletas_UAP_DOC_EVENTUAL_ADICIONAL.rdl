                                                <TextRuns>
                                                  <TextRun>
                                                    <Value>="DATOS FUNCIONARIO - " + Microsoft.VisualBasic.Interaction.iif(Fields!ti_tipo.Value = "ADM", " ADMINISTRATIVO ", Microsoft.VisualBasic.Interaction.iif(Fields!ti_tipo.Value = "DOC", "DOCENTE ", "-")) + Microsoft.VisualBasic.Interaction.IIF(Fields!PLANTA_CONTRATO.Value = "P", "PLANTA", "EVENTUAL")</Value>
