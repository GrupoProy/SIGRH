<?xml version="1.0" encoding="utf-8"?>
<Report MustUnderstand="df" xmlns="http://schemas.microsoft.com/sqlserver/reporting/2016/01/reportdefinition" xmlns:rd="http://schemas.microsoft.com/SQLServer/reporting/reportdesigner" xmlns:df="http://schemas.microsoft.com/sqlserver/reporting/2016/01/reportdefinition/defaultfontfamily">
  <df:DefaultFontFamily>Segoe UI</df:DefaultFontFamily>
  <AutoRefresh>0</AutoRefresh>
  <DataSources>
    <DataSource Name="Planillas">
      <DataSourceReference>Planillas</DataSourceReference>
      <rd:SecurityType>DataBase</rd:SecurityType>
      <rd:DataSourceID>ba810aca-d4fd-4218-9ba8-8f51f261d041</rd:DataSourceID>
    </DataSource>
  </DataSources>
  <DataSets>
    <DataSet Name="DataSet1">
      <Query>
        <DataSourceName>Planillas</DataSourceName>
        <QueryParameters>
          <QueryParameter Name="@MES_GESTION">
            <Value>=Parameters!MES_GESTION.Value</Value>
          </QueryParameter>
          <QueryParameter Name="@SECUENCIAL">
            <Value>=Parameters!SECUENCIAL.Value</Value>
          </QueryParameter>
        </QueryParameters>
        <CommandText>SELECT        PLANTA_CONTRATO, ti_tipo, TIPO_APORTANTE, NOMBRES_COMPLETO, CI, es_descripcion, es_escalafon, sum(pla_hrs_trab) as pla_hrs_trab, FUENTE_ORG, H_BASICO, sum(HGANADO) as HGANADO, sum(ESCALAFON) as ESCALAFON, sum(BONO_ANT) as BONO_ANT, sum(BONO_FRONTERA) as BONO_FRONTERA, sum(TOTAL_GANADO) as TOTAL_GANADO, 
                         sum(AFP) as AFP, sum(AFP_NAL) as AFP_NAL, AFP_PORCENTAJE, sum(JUEGOS_DEPS) as JUEGOS_DEPS, sum(FUD) as FUD, sum(CUD) as CUD, sum(ASISTENCIA) as ASISTENCIA, sum(JUDICIAL) as JUDICIAL, sum(DESC_FUD) as DESC_FUD, sum(D_FA_M) as D_FA_M, sum(IBERIA) as IBERIA, sum(ACRE) as ACRE, sum(OTROS) as OTROS, sum(T_DESC) as T_DESC, sum(LIQUIDO) as LIQUIDO, facultad, pla_fecha_alta
FROM            (SELECT  distinct    tbl_mp_tipo_item.ti_tipo_item_gral AS PLANTA_CONTRATO, tbl_mp_tipo_item.ti_tipo,
dbo.ObtenerTipoAportante(tbl_pla_boleta_historico.CBH_per_id) as TIPO_APORTANTE,
 DBO.fn_Fecha_Ingreso_C(tbl_pla_boleta_historico.CBH_per_id,A.as_ca_id) AS pla_fecha_alta, RTRIM(tbl_persona.per_ap_paterno) + ' ' + RTRIM(tbl_persona.per_ap_materno) + ' ' + RTRIM(ISNULL(tbl_persona.per_ap_casada, N'')) 
                         + ' ' + RTRIM(tbl_persona.per_nombres) AS NOMBRES_COMPLETO, tbl_persona.per_num_doc + ' ' + General.dbo.tbl_catalogo.cat_abreviacion AS CI, 
						 tbl_mp_escala_salarial.es_descripcion+'-'+ dbo.ObtenerTipoJornada(tbl_mp_cargo.ca_id) AS es_descripcion, 
                         tbl_mp_escala_salarial.es_escalafon, 

						 HT.ht_horas_mes AS pla_hrs_trab,
						 tbl_pla_boleta_historico.cbh_anios_sevicio AS CS_ANOS, CONVERT(NVARCHAR(5), tbl_mp_categoria_programatica.cp_fuente) + '-' + CONVERT(NVARCHAR(5), 
                         tbl_mp_categoria_programatica.cp_organismo) AS FUENTE_ORG,
						 tbl_mp_cargo.ca_basico_calculado  AS H_BASICO,
			SUM(CASE  WHEN (DBH.dbh_fa_id IN (61)) THEN DBH.dbh_valor ELSE 0 END) AS HGANADO,
			SUM(CASE  WHEN (DBH.dbh_fa_id IN (41)) THEN DBH.dbh_valor ELSE 0 END) AS ESCALAFON,
			SUM(CASE  WHEN (DBH.dbh_fa_id IN (24)) THEN DBH.dbh_valor ELSE 0 END) AS BONO_ANT,
			SUM(CASE  WHEN (DBH.dbh_fa_id IN (43)) THEN DBH.dbh_valor ELSE 0 END) AS BONO_FRONTERA, 
			SUM(CASE  WHEN (DBH.dbh_fa_id IN (61 , 24, 43, 41)) THEN DBH.dbh_valor ELSE 0 END) AS TOTAL_GANADO,
			SUM(CASE  WHEN (DBH.dbh_fa_id IN (26,27,213,216,1004,1009)) THEN DBH.dbh_valor ELSE 0 END) AS AFP,  
			SUM(CASE  WHEN (DBH.dbh_fa_id IN (215,218,1011)) THEN DBH.dbh_valor ELSE 0 END) AS AFP_NAL ,
			DBO.ObtenerTotalAporte(tbl_pla_boleta_historico.CBH_PER_ID) AS AFP_PORCENTAJE,
			SUM(CASE  WHEN (DBH.dbh_fa_id IN (104)) THEN DBH.dbh_valor ELSE 0 END) AS JUEGOS_DEPS,
			SUM(CASE  WHEN (DBH.dbh_fa_id IN (105)) THEN DBH.dbh_valor ELSE 0 END) AS FUD,
			SUM(CASE  WHEN (DBH.dbh_fa_id IN (106)) THEN DBH.dbh_valor ELSE 0 END) AS CUD,
			SUM(CASE  WHEN (DBH.dbh_fa_id IN (57,58)) THEN DBH.dbh_valor ELSE 0 END)  AS ASISTENCIA,
			SUM(CASE  WHEN (DBH.dbh_fa_id IN (51,52,54)) THEN DBH.dbh_valor ELSE 0 END) AS JUDICIAL,
			SUM(CASE  WHEN (DBH.dbh_fa_id IN (1001)) THEN DBH.dbh_valor ELSE 0 END) AS DESC_FUD,
			0 AS D_FA_M,
			SUM(CASE  WHEN (DBH.dbh_fa_id IN (100)) THEN DBH.dbh_valor ELSE 0 END) AS IBERIA,--CONVENIOS
			SUM(CASE  WHEN (DBH.dbh_fa_id IN (101)) THEN DBH.dbh_valor ELSE 0 END) AS ACRE,--CONVENIOS
			SUM(CASE  WHEN F.fa_signo = '-' AND DBH.dbh_fa_id NOT IN (26,27,213,216,215,218,104,105,106,57,58,51,52,54,1001,100,101,1004,1009,1011) THEN DBH.dbh_valor ELSE 0 END) AS OTROS,
			SUM(CASE WHEN (F.fa_signo = '-') THEN DBH.dbh_valor ELSE 0 END) AS T_DESC,
			SUM(CASE WHEN (F.fa_signo = '+') THEN DBH.dbh_valor ELSE 0 END) - SUM(CASE WHEN (F.fa_signo = '-') THEN DBH.dbh_valor ELSE 0 END)   AS LIQUIDO,tbl_mp_estructura_organizacional.eo_descripcion,tbl_pla_boleta_historico.cbh_id
, tbl_mp_cargo.ca_ti_item+' '+CONVERT(NVARCHAR(5),tbl_mp_cargo.ca_num_item) AS ITEM
,(SELECT        eo_descripcion
                               FROM            tbl_mp_estructura_organizacional AS EOAr
                               WHERE        (eo_id =
                                                             (SELECT        eo_cod_superior
                                                               FROM            tbl_mp_estructura_organizacional AS EO
                                                               WHERE        (eo_id = tbl_mp_estructura_organizacional.eo_cod_superior)))) AS facultad
FROM            tbl_pla_boleta_historico INNER JOIN
                         tbl_mp_cargo ON tbl_pla_boleta_historico.cbh_ca_id = tbl_mp_cargo.ca_id INNER JOIN 
                         tbl_persona ON tbl_pla_boleta_historico.cbh_per_id = tbl_persona.per_id INNER JOIN
                         tbl_mp_escala_salarial ON tbl_mp_cargo.ca_es_id = tbl_mp_escala_salarial.es_id INNER JOIN
                         tbl_mp_estructura_organizacional ON tbl_mp_cargo.ca_eo_id = tbl_mp_estructura_organizacional.eo_id INNER JOIN
                         tbl_mp_categoria_programatica ON tbl_mp_estructura_organizacional.eo_cp_id = tbl_mp_categoria_programatica.cp_id INNER JOIN
                         General.dbo.tbl_catalogo ON tbl_persona.per_lugar_exp = General.dbo.tbl_catalogo.cat_id INNER JOIN
						 tbl_pla_proceso ON tbl_pla_boleta_historico.cbh_pc_id = tbl_pla_proceso.pc_id INNER JOIN
						 tbl_pla_det_boleta_historico DBH ON tbl_pla_boleta_historico.cbh_id = DBH.DBH_CBH_ID inner join
						 tbl_mp_tipo_item on tbl_mp_tipo_item.ti_item = tbl_mp_cargo.ca_ti_item INNER JOIN
						 TBL_PLA_FACTOR F ON DBH.dbh_fa_id= F.fa_id INNER JOIN
						 tbl_mp_asignacion A ON tbl_pla_boleta_historico.cbh_ca_id = A.as_ca_id AND tbl_pla_boleta_historico.cbh_per_iD= A.as_per_id AND A.as_estado &lt;&gt;'S' INNER JOIN 
				tbl_doc_materias_cargo MC ON tbl_mp_cargo.ca_id = MC.mc_ca_id INNER JOIN
				tbl_doc_horas_trabajadas HT ON HT.ht_mc_id = MC.mc_id AND HT.ht_pc_id = tbl_pla_boleta_historico.cbh_pc_id
				--TBL_PLA_DOCENTE_HORAS ON TBL_PLA_DOCENTE_HORAS.PDH_PER_ID= tbl_pla_boleta_historico.CBH_PER_ID AND  
				--TBL_PLA_DOCENTE_HORAS.pdh_pc_id = tbl_pla_boleta_historico.CBH_PC_ID and pdh_as_id = A.as_id AND pdh_estado in('V','H')
WHERE        (tbl_pla_boleta_historico.cbh_tipo_func = 'DOC') and  (tbl_mp_tipo_item.ti_tipo_item_gral= 'C') 
AND  tbl_pla_proceso.pc_id = @MES_GESTION  and tbl_pla_boleta_historico.cbh_pla_NRO = @SECUENCIAL
GROUP BY tbl_pla_boleta_historico.CBH_per_id, RTRIM(tbl_persona.per_ap_paterno) ,RTRIM(tbl_persona.per_ap_materno),RTRIM(ISNULL(tbl_persona.per_ap_casada, N'')) 
    ,RTRIM(tbl_persona.per_nombres) , tbl_persona.per_num_doc + ' ' + General.dbo.tbl_catalogo.cat_abreviacion, tbl_mp_escala_salarial.es_descripcion, 
        tbl_mp_escala_salarial.es_escalafon, tbl_pla_boleta_historico.CBH_dias_trab,tbl_pla_boleta_historico.cbh_anios_sevicio ,tbl_mp_categoria_programatica.cp_fuentE, 
        tbl_mp_categoria_programatica.cp_organismo,tbl_mp_cargo.ca_basico_calculado, tbl_mp_tipo_item.ti_tipo_item_gral, tbl_mp_cargo.ca_basico_calculado, tbl_mp_estructura_organizacional.eo_descripcion
		,A.as_fecha_inicio ,tbl_pla_boleta_historico.cbh_id,tbl_mp_tipo_item.ti_tipo, tbl_mp_cargo.ca_ti_item,CONVERT(NVARCHAR(5),tbl_mp_cargo.ca_num_item), tbl_mp_cargo.ca_id ,HT.ht_horas_mes,A.as_ca_id,tbl_mp_estructura_organizacional.eo_cod_superior) AS Tabla1
group by PLANTA_CONTRATO, ti_tipo, TIPO_APORTANTE, NOMBRES_COMPLETO, CI, es_descripcion, es_escalafon, FUENTE_ORG, H_BASICO, AFP_PORCENTAJE, facultad, pla_fecha_alta</CommandText>
        <rd:UseGenericDesigner>true</rd:UseGenericDesigner>
      </Query>
