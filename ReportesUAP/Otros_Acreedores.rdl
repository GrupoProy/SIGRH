<?xml version="1.0" encoding="utf-8"?>
<Report MustUnderstand="df" xmlns="http://schemas.microsoft.com/sqlserver/reporting/2016/01/reportdefinition" xmlns:rd="http://schemas.microsoft.com/SQLServer/reporting/reportdesigner" xmlns:df="http://schemas.microsoft.com/sqlserver/reporting/2016/01/reportdefinition/defaultfontfamily">
  <df:DefaultFontFamily>Segoe UI</df:DefaultFontFamily>
  <AutoRefresh>0</AutoRefresh>
  <DataSources>
    <DataSource Name="DataSource1">
      <ConnectionProperties>
        <DataProvider>SQL</DataProvider>
        <ConnectString>Data Source=172.16.21.100;Initial Catalog=sigrh3</ConnectString>
      </ConnectionProperties>
      <rd:SecurityType>DataBase</rd:SecurityType>
      <rd:DataSourceID>c63813f7-86d2-47e9-9fa8-e4edaf54b289</rd:DataSourceID>
    </DataSource>
  </DataSources>
  <DataSets>
    <DataSet Name="DataSet1">
      <Query>
        <DataSourceName>DataSource1</DataSourceName>
        <QueryParameters>
          <QueryParameter Name="@NROPLANILLA">
            <Value>=Parameters!NROPLANILLA.Value</Value>
            <rd:UserDefined>true</rd:UserDefined>
          </QueryParameter>
          <QueryParameter Name="@CODMES">
            <Value>=Parameters!CODMES.Value</Value>
            <rd:UserDefined>true</rd:UserDefined>
          </QueryParameter>
        </QueryParameters>
        <CommandText>USE sigrh3
	
SELECT        
per_id, RTRIM(tbl_persona.per_ap_paterno) PATERNO,RTRIM(tbl_persona.per_ap_materno) MATERNO,RTRIM(tbl_persona.per_nombres) NOMBRES ,tbl_persona.per_num_doc,tbl_pla_boleta_historico.cbh_afp ,
tbl_pla_proceso.pc_titulo,tbl_pla_boleta_historico.cbh_tipo_func, tbl_pla_boleta_historico.cbh_pla_NRO , tbl_mp_categoria_programatica.cp_programa, tbl_mp_categoria_programatica.cp_proyecto, tbl_mp_categoria_programatica.cp_actividad, tbl_mp_categoria_programatica.cp_descripcion, 
Convert (varChar(3),tbl_mp_categoria_programatica.cp_fuente) +'-'+Convert(varChar (4),tbl_mp_categoria_programatica.cp_organismo) as fufi, tbl_mp_tipo_item.ti_tipo_item_gral AS PLANTA_CONTRATO , case when tbl_tipo_aportante.ta_descripcion ='' then 'PLANILLA GENERAL' ELSE RTRIM(tbl_tipo_aportante.ta_descripcion) END AS TIPO_DE_PLANILLA
						 , dbo.ObtenerTipoAportante(tbl_pla_boleta_historico.cbh_per_id) AS TIPO_APORTANTE
 ,F.fa_descripcion,DBH.dbh_fa_id,DBH.dbh_valor
, (Select pc_titulo from tbl_pla_proceso where pc_id=@CODMES) as MES
FROM            tbl_tipo_aportante INNER JOIN
                         tbl_mp_asignacion_tipo_aportante ON tbl_tipo_aportante.ta_id = tbl_mp_asignacion_tipo_aportante.at_ta_id INNER JOIN
                         tbl_pla_boleta_historico INNER JOIN
                         tbl_mp_cargo ON tbl_pla_boleta_historico.cbh_ca_id = tbl_mp_cargo.ca_id INNER JOIN
                         tbl_persona ON tbl_pla_boleta_historico.cbh_per_id = tbl_persona.per_id INNER JOIN
                         tbl_mp_escala_salarial ON tbl_mp_cargo.ca_es_id = tbl_mp_escala_salarial.es_id INNER JOIN
                         tbl_mp_estructura_organizacional ON tbl_mp_cargo.ca_eo_id = tbl_mp_estructura_organizacional.eo_id INNER JOIN
                         tbl_mp_categoria_programatica ON tbl_mp_estructura_organizacional.eo_cp_id = tbl_mp_categoria_programatica.cp_id INNER JOIN
                         General.dbo.tbl_catalogo ON tbl_persona.per_lugar_exp = General.dbo.tbl_catalogo.cat_id INNER JOIN
                         tbl_pla_proceso ON tbl_pla_boleta_historico.cbh_pc_id = tbl_pla_proceso.pc_id INNER JOIN
                         tbl_pla_det_boleta_historico AS DBH ON tbl_pla_boleta_historico.cbh_id = DBH.dbh_cbh_id INNER JOIN
                         tbl_mp_tipo_item ON tbl_mp_tipo_item.ti_item = tbl_mp_cargo.ca_ti_item INNER JOIN
                         tbl_pla_factor AS F ON DBH.dbh_fa_id = F.fa_id INNER JOIN
                         tbl_mp_asignacion AS A ON tbl_pla_boleta_historico.cbh_ca_id = A.as_ca_id AND tbl_pla_boleta_historico.cbh_per_id = A.as_per_id AND A.as_estado &lt;&gt; 'S' ON 
                         tbl_mp_asignacion_tipo_aportante.at_per_id = tbl_pla_boleta_historico.cbh_per_id
WHERE        (tbl_pla_boleta_historico.cbh_tipo_func IN ('ADM', 'DOC','CON'))   AND (tbl_mp_asignacion_tipo_aportante.at_estado = 'V') AND 
                         (tbl_tipo_aportante.ta_estado = 'V')  AND (tbl_pla_proceso.pc_id = @CODMES) AND (tbl_pla_boleta_historico.cbh_pla_NRO =@NROPLANILLA)
						 and DBH.dbh_fa_id NOT IN (26, 27, 213, 216, 215, 218, 32, 999, 57, 58, 51, 52, 54,  999,61,24,41,43,61, 24, 43,41,61, 24, 43,41,61, 24, 43,41,26, 27, 213, 216,215, 218,32,999,57, 58,51, 52, 54 
						 ,26, 27, 213, 216, 215, 218, 32, 999, 57, 58, 51, 52, 54,  999,221,28, 29,217, 214,98, 99,301,302,303,304,305,306,216,213,301,303,305,213
						 ,302,304,306,216,215,218,98,99,28,29,217,214,221,104,106,105, 1008,1005,1010,1011,1014,1004,1009,1012,1013,1001) 
						 and DBH.dbh_valor &lt;&gt;0 
--GROUP BY tbl_mp_categoria_programatica.cp_programa, tbl_mp_categoria_programatica.cp_proyecto, tbl_mp_categoria_programatica.cp_actividad, tbl_mp_categoria_programatica.cp_descripcion, 
--                         tbl_mp_categoria_programatica.cp_fuente, tbl_mp_categoria_programatica.cp_organismo, tbl_mp_tipo_item.ti_tipo_item_gral, tbl_tipo_aportante.ta_descripcion
--						 ,tbl_pla_proceso.pc_titulo, tbl_pla_boleta_historico.cbh_pla_NRO ,tbl_pla_boleta_historico.cbh_tipo_func
--,per_id, RTRIM(tbl_persona.per_ap_paterno) ,RTRIM(tbl_persona.per_ap_materno),tbl_persona.per_nombres,tbl_persona.per_num_doc ,tbl_pla_boleta_historico.cbh_afp
	
ORDER BY pc_titulo, cbh_pla_NRO, cp_descripcion,2</CommandText>
      </Query>
      <Fields>
        <Field Name="per_id">
          <DataField>per_id</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
        <Field Name="PATERNO">
          <DataField>PATERNO</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="MATERNO">
          <DataField>MATERNO</DataField>
