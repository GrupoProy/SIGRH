<?xml version="1.0" encoding="utf-8"?>
<Report MustUnderstand="df" xmlns="http://schemas.microsoft.com/sqlserver/reporting/2016/01/reportdefinition" xmlns:rd="http://schemas.microsoft.com/SQLServer/reporting/reportdesigner" xmlns:df="http://schemas.microsoft.com/sqlserver/reporting/2016/01/reportdefinition/defaultfontfamily">
  <df:DefaultFontFamily>Segoe UI</df:DefaultFontFamily>
  <AutoRefresh>0</AutoRefresh>
  <DataSources>
    <DataSource Name="Planillas">
      <DataSourceReference>Planillas</DataSourceReference>
      <rd:SecurityType>None</rd:SecurityType>
      <rd:DataSourceID>a22278a8-c203-473d-8d2e-e2bfc677d7ea</rd:DataSourceID>
    </DataSource>
  </DataSources>
  <DataSets>
    <DataSet Name="DataSet1">
      <Query>
        <DataSourceName>Planillas</DataSourceName>
        <QueryParameters>
          <QueryParameter Name="@cod_persona2">
            <Value>=Parameters!cod_persona2.Value</Value>
          </QueryParameter>
        </QueryParameters>
        <CommandText>SELECT        TOP (1) vac_id, vac_per_id, vac_a_partir, vac_hasta, vac_va_id, vac_nro_dias_vacacion, vac_observacion, 
dbo.NumeroLiteral(vac_nro_dias_vacacion) as dias_literal,vac_motivo_anulado, vac_fecha_anulado, vac_correlativo, vac_usuario_creacion, vac_fecha_creacion, 
vac_lj_id,CONCAT(RTRIM(LTRIM(P.per_nombres)), ' ', RTRIM(LTRIM(P.per_ap_paterno)), ' ', RTRIM(LTRIM(P.per_ap_materno)), ' ') AS nombre_autoriza,
ES.es_descripcion AS CARGO_AUTORIZA
FROM            tbl_kd_solicitud_vacacion INNER  JOIN
tbl_mp_asignacion A ON A.as_per_id = tbl_kd_solicitud_vacacion.vac_per_id_AUTORIZA AND A.as_estado ='V'JOIN
tbl_mp_cargo C ON A.as_ca_id = C.ca_id INNER JOIN
tbl_mp_estructura_organizacional EO ON C.ca_eo_id = EO.eo_id INNER JOIN
tbl_mp_escala_salarial ES ON C.ca_es_id= ES.es_id INNER JOIN
tbl_mp_tipo_item T ON C.ca_ti_item = T.ti_item and T.ti_tipo ='ADM' INNER JOIN
tbl_persona P ON P.per_id = tbl_kd_solicitud_vacacion.vac_per_id_autoriza
WHERE        (vac_id = @cod_persona2) AND (vac_estado = 'V')
ORDER BY vac_id DESC</CommandText>
        <rd:UseGenericDesigner>true</rd:UseGenericDesigner>
      </Query>
