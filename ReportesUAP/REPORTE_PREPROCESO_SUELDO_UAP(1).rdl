<?xml version="1.0" encoding="utf-8"?>
<Report MustUnderstand="df" xmlns="http://schemas.microsoft.com/sqlserver/reporting/2016/01/reportdefinition" xmlns:rd="http://schemas.microsoft.com/SQLServer/reporting/reportdesigner" xmlns:df="http://schemas.microsoft.com/sqlserver/reporting/2016/01/reportdefinition/defaultfontfamily">
  <df:DefaultFontFamily>Segoe UI</df:DefaultFontFamily>
  <AutoRefresh>0</AutoRefresh>
  <DataSources>
    <DataSource Name="Planillas">
      <DataSourceReference>Planillas</DataSourceReference>
      <rd:SecurityType>None</rd:SecurityType>
      <rd:DataSourceID>8dcd0aa7-1aa9-43de-966f-5f6735bd08e8</rd:DataSourceID>
    </DataSource>
  </DataSources>
  <DataSets>
    <DataSet Name="DataSet1">
      <Query>
        <DataSourceName>Planillas</DataSourceName>
        <CommandText>EXEC [DBO].[SP_PLA_PRESUELDO]

SELECT       tpo_id, tpo_descripcion, tpo_pc_id
FROM            tbl_tmp_pla_observacion
WHERE tbl_tmp_pla_observacion.tpo_prefijo='0'
AND tpo_pc_id IN(
	SELECT   
	proceso_id FROM     V_PLA_parametros_sueldo)
ORDER BY 1</CommandText>
        <rd:UseGenericDesigner>true</rd:UseGenericDesigner>
      </Query>
      <Fields>
        <Field Name="tpo_id">
          <DataField>tpo_id</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
        <Field Name="tpo_descripcion">
          <DataField>tpo_descripcion</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="tpo_pc_id">
          <DataField>tpo_pc_id</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
      </Fields>
    </DataSet>
    <DataSet Name="DataSet2">
      <Query>
        <DataSourceName>Planillas</DataSourceName>
        <CommandText>
	SELECT   
	proceso_id, 
	periodo_id, 
	nom_mes_proceso, 
	fecha_ini_proceso, 
	fecha_fin_proceso, 
	ufv_proceso, 
	fecha_ufv_proceso,
	minimo_nacional, 
	gestion_proceso, 
	gestion_periodo,
prefijo_proceso 
FROM     V_PLA_parametros_sueldo</CommandText>
      </Query>
      <Fields>
        <Field Name="proceso_id">
          <DataField>proceso_id</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
        <Field Name="periodo_id">
          <DataField>periodo_id</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
        <Field Name="nom_mes_proceso">
          <DataField>nom_mes_proceso</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="fecha_ini_proceso">
          <DataField>fecha_ini_proceso</DataField>
          <rd:TypeName>System.DateTime</rd:TypeName>
        </Field>
        <Field Name="fecha_fin_proceso">
          <DataField>fecha_fin_proceso</DataField>
          <rd:TypeName>System.DateTime</rd:TypeName>
        </Field>
        <Field Name="ufv_proceso">
          <DataField>ufv_proceso</DataField>
          <rd:TypeName>System.Decimal</rd:TypeName>
        </Field>
        <Field Name="fecha_ufv_proceso">
          <DataField>fecha_ufv_proceso</DataField>
          <rd:TypeName>System.DateTime</rd:TypeName>
        </Field>
        <Field Name="minimo_nacional">
          <DataField>minimo_nacional</DataField>
          <rd:TypeName>System.Decimal</rd:TypeName>
        </Field>
        <Field Name="gestion_proceso">
          <DataField>gestion_proceso</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
        <Field Name="gestion_periodo">
          <DataField>gestion_periodo</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
        <Field Name="prefijo_proceso">
          <DataField>prefijo_proceso</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
      </Fields>
    </DataSet>
    <DataSet Name="DataSet3">
      <Query>
        <DataSourceName>Planillas</DataSourceName>
        <CommandText>SELECT        tpo_id, tpo_descripcion, tpo_pc_id
FROM            tbl_tmp_pla_observacion
WHERE        (LEFT(tpo_descripcion, 1) = '-') AND TPO_PREFIJO ='0'</CommandText>
      </Query>
      <Fields>
        <Field Name="tpo_id">
          <DataField>tpo_id</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
        <Field Name="tpo_descripcion">
          <DataField>tpo_descripcion</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="tpo_pc_id">
          <DataField>tpo_pc_id</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
      </Fields>
    </DataSet>
  </DataSets>
