<?xml version="1.0" encoding="utf-8"?>
<Report MustUnderstand="df" xmlns="http://schemas.microsoft.com/sqlserver/reporting/2016/01/reportdefinition" xmlns:rd="http://schemas.microsoft.com/SQLServer/reporting/reportdesigner" xmlns:df="http://schemas.microsoft.com/sqlserver/reporting/2016/01/reportdefinition/defaultfontfamily">
  <df:DefaultFontFamily>Segoe UI</df:DefaultFontFamily>
  <AutoRefresh>0</AutoRefresh>
  <DataSources>
    <DataSource Name="DataSource1">
      <DataSourceReference>Planillas</DataSourceReference>
      <rd:SecurityType>None</rd:SecurityType>
      <rd:DataSourceID>9577ba0f-afb1-4502-a353-6b1465d5b6a7</rd:DataSourceID>
    </DataSource>
    <DataSource Name="DataSource2">
      <DataSourceReference>Planillas</DataSourceReference>
      <rd:SecurityType>None</rd:SecurityType>
      <rd:DataSourceID>a5c2d955-da15-4af8-8efe-c91a7da6fdf9</rd:DataSourceID>
    </DataSource>
  </DataSources>
  <DataSets>
    <DataSet Name="DataSet1">
      <Query>
        <DataSourceName>DataSource1</DataSourceName>
        <QueryParameters>
          <QueryParameter Name="@MES">
            <Value>=Parameters!MES.Value</Value>
          </QueryParameter>
        </QueryParameters>
        <CommandText>SELECT DISTINCT tbl_persona.per_id, (tbl_persona.per_ap_paterno + ' '+ tbl_persona.per_ap_materno +' '+ tbl_persona.per_nombres) AS nombre_completo, tbl_mp_tipo_item.ti_tipo, tbl_mp_tipo_item.ti_item, per_fecha_nac,
                         tbl_mp_estructura_organizacional.eo_descripcion
FROM            tbl_mp_tipo_item INNER JOIN
                         tbl_mp_asignacion INNER JOIN
                         tbl_mp_cargo ON tbl_mp_asignacion.as_ca_id = tbl_mp_cargo.ca_id INNER JOIN
                         tbl_persona ON tbl_mp_asignacion.as_per_id = tbl_persona.per_id INNER JOIN
                         tbl_mp_estructura_organizacional ON tbl_mp_cargo.ca_eo_id = tbl_mp_estructura_organizacional.eo_id ON tbl_mp_tipo_item.ti_item = tbl_mp_cargo.ca_ti_item
WHERE as_estado = 'V' AND ca_estado = 'O' AND ti_item = 'P' AND ti_tipo = 'ADM' AND MONTH(per_fecha_nac) = @MES
ORDER BY nombre_completo ASC</CommandText>
      </Query>
      <Fields>
        <Field Name="per_id">
          <DataField>per_id</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
        <Field Name="nombre_completo">
          <DataField>nombre_completo</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="ti_tipo">
          <DataField>ti_tipo</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="ti_item">
          <DataField>ti_item</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="per_fecha_nac">
          <DataField>per_fecha_nac</DataField>
          <rd:TypeName>System.DateTime</rd:TypeName>
        </Field>
        <Field Name="eo_descripcion">
          <DataField>eo_descripcion</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
      </Fields>
    </DataSet>
    <DataSet Name="DataSet2">
      <Query>
        <DataSourceName>DataSource2</DataSourceName>
        <QueryParameters>
          <QueryParameter Name="@MES">
            <Value>=Parameters!MES.Value</Value>
          </QueryParameter>
        </QueryParameters>
        <CommandText>SELECT DISTINCT tbl_persona.per_id, (tbl_persona.per_ap_paterno + ' '+ tbl_persona.per_ap_materno +' '+ tbl_persona.per_nombres) AS nombre_completo, tbl_mp_tipo_item.ti_tipo, tbl_mp_tipo_item.ti_item, per_fecha_nac,
                         tbl_mp_estructura_organizacional.eo_descripcion
FROM            tbl_mp_tipo_item INNER JOIN
                         tbl_mp_asignacion INNER JOIN
                         tbl_mp_cargo ON tbl_mp_asignacion.as_ca_id = tbl_mp_cargo.ca_id INNER JOIN
                         tbl_persona ON tbl_mp_asignacion.as_per_id = tbl_persona.per_id INNER JOIN
                         tbl_mp_estructura_organizacional ON tbl_mp_cargo.ca_eo_id = tbl_mp_estructura_organizacional.eo_id ON tbl_mp_tipo_item.ti_item = tbl_mp_cargo.ca_ti_item
WHERE as_estado = 'V' AND ca_estado = 'O' AND ti_item = 'E' AND ti_tipo = 'DOC' AND MONTH(per_fecha_nac) = @MES
ORDER BY nombre_completo ASC</CommandText>
      </Query>
      <Fields>
        <Field Name="per_id">
