<?xml version="1.0" encoding="utf-8"?>
<Report MustUnderstand="df" xmlns="http://schemas.microsoft.com/sqlserver/reporting/2016/01/reportdefinition" xmlns:rd="http://schemas.microsoft.com/SQLServer/reporting/reportdesigner" xmlns:df="http://schemas.microsoft.com/sqlserver/reporting/2016/01/reportdefinition/defaultfontfamily">
  <df:DefaultFontFamily>Segoe UI</df:DefaultFontFamily>
  <AutoRefresh>0</AutoRefresh>
  <DataSources>
    <DataSource Name="DataSource1">
      <DataSourceReference>Planillas</DataSourceReference>
      <rd:SecurityType>None</rd:SecurityType>
      <rd:DataSourceID>9ecdc320-9586-4e37-98f2-041fd28416dd</rd:DataSourceID>
    </DataSource>
  </DataSources>
  <DataSets>
    <DataSet Name="DataSet1">
      <Query>
        <DataSourceName>DataSource1</DataSourceName>
        <QueryParameters>
          <QueryParameter Name="@descrip_pu_id">
            <Value>=Parameters!descrip_pu_id.Value</Value>
          </QueryParameter>
        </QueryParameters>
        <CommandText>SELECT        tbl_mp_descriptor_puestos.descrip_pu_id, tbl_mp_descriptor_puestos.superv_id, tbl_mp_descriptor_puestos.descrip_pu_objetivo, tbl_mp_descriptor_puestos.descrip_pu_estado, tbl_mp_cargo.ca_id, 
                         tbl_mp_descriptor_puestos_resultados.result_ponderacion, tbl_mp_descriptor_puestos_resultados.result_indicador, tbl_mp_descriptor_puestos_resultados.result_resultado, tbl_mp_escala_salarial.es_descripcion, 
                         FORMAT(tbl_mp_asignacion.as_fecha_inicio, 'dd/ MM/ yyyy') AS INICIO, FORMAT(tbl_mp_asignacion.as_fecha_fin, 'dd/ MM/ yyyy') AS FINAL, tbl_mp_estructura_organizacional.eo_descripcion, 
                         tbl_mp_estructura_organizacional.eo_unidad, tbl_puestos.p_descripcion, tbl_mp_cargo.ca_ti_item + '-' + CONVERT(varchar(8), tbl_mp_cargo.ca_num_item) AS Item, tbl_requisito_formacion.rf_id, 
                         tbl_requisito_formacion.rf_formacion, tbl_requisito_formacion.rf_exp_gral
FROM            tbl_mp_descriptor_puestos INNER JOIN
                         tbl_mp_descriptor_puestos_resultados ON tbl_mp_descriptor_puestos.descrip_pu_id = tbl_mp_descriptor_puestos_resultados.descrip_pu_id INNER JOIN
                         tbl_mp_cargo ON tbl_mp_descriptor_puestos.descrip_pu_ca_id = tbl_mp_cargo.ca_id INNER JOIN
                         tbl_mp_escala_salarial ON tbl_mp_cargo.ca_es_id = tbl_mp_escala_salarial.es_id INNER JOIN
                         tbl_mp_asignacion ON tbl_mp_cargo.ca_id = tbl_mp_asignacion.as_ca_id INNER JOIN
                         tbl_mp_estructura_organizacional ON tbl_mp_cargo.ca_eo_id = tbl_mp_estructura_organizacional.eo_id INNER JOIN
                         tbl_mp_cargo_puesto ON tbl_mp_cargo.ca_id = tbl_mp_cargo_puesto.cap_ca_id INNER JOIN
                         tbl_puestos ON tbl_mp_cargo_puesto.cap_p_id = tbl_puestos.p_id INNER JOIN
                         tbl_requisito_formacion ON tbl_mp_escala_salarial.es_rf_id = tbl_requisito_formacion.rf_id
WHERE  (tbl_mp_descriptor_puestos.descrip_pu_id = @descrip_pu_id)</CommandText>
      </Query>
      <Fields>
        <Field Name="descrip_pu_id">
          <DataField>descrip_pu_id</DataField>
