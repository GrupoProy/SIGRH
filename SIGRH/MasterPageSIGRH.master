    <script>
        //Cargando mascara
        document.onreadystatechange = function () {
            setTimeout(function () {
                document.getElementById('load').style.display = 'none';
                if (window.location.href.search("MovimientoPersonal") != -1 || window.location.href.search("Salarios") != -1) {
                    $("#elBody").css("background-image", "url('../Content/img/33.png')");
                    $("#tit").text("Módulo Planillas - PARABA AZÚL");
                }
                if (window.location.href.search("ControlPersonal") != -1) {
                    $("#elBody").css("background-image", "url('../Content/img/44.png')");
                    $("#tit").text("Módulo Control de Personal - JAGUAR");
                }
                if (window.location.href.search("Kardex") != -1) {
                    $("#elBody").css("background-image", "url('../Content/img/55.png')");
                    $("#tit").text("Módulo Kardex - MARTIN PESCADOR");
                }
                if (window.location.href.search("Docente") != -1) {
                    $("#elBody").css("background-image", "url('../Content/img/44.png')");
                    $("#tit").text("Módulo Docente - JAGUAR");
                }
                $("#btn_login_sigrh").css("background-image", "url('Content/img/boton_verde.png')");
            }, 0);
        }

        function MostrarMascara(pValor) {
            if (pValor) {
                document.getElementById('load').style.display = 'block';
            } else {
                document.getElementById('load').style.display = 'none';
            }

        }

        //Cargando JSON
        var variablesResporte = [];
        $.get("../Content/js/JSON/VariablesQuill.json", function (json) {
            variablesResporte = json;
        });

        //Atras
        function goBack() {
            MostrarMascara(true);
            window.history.back();
            console.log("atras");
        }

        let urlAcutal = window.location.pathname.split('/');
        ////urlAcutal = urlAcutal[urlAcutal.length - 1]
        //if (window.location.href.search("ListadoEvaluacion.aspx") != -1) {
        //    urlAcutal = window.location.href;

        //    if (urlAcutal.indexOf("ListadoEvaluacion.aspx?id=1") !== -1) {
        //        urlAcutal = urlAcutal.substring(urlAcutal.indexOf("ListadoEvaluacion.aspx?id=1"), urlAcutal.length)
        //    } else {
        //        urlAcutal = urlAcutal.substring(urlAcutal.indexOf("ListadoEvaluacion.aspx?id=2"), urlAcutal.length)
        //    }

        //} else {
        //    urlAcutal = urlAcutal[urlAcutal.length - 1]
        //}

        urlAcutal = urlAcutal[urlAcutal.length - 1]
    
        let HistorialURL = JSON.parse(localStorage.getItem('HistorialURL'))

        if (HistorialURL !== null) {
            if (HistorialURL.length > 0) {
                let verificarUrl = false;
                for (let i in HistorialURL) {
                    if (HistorialURL[i].url === urlAcutal) {
                        verificarUrl = true;
                    }
                }
                if (!verificarUrl) {
                    HistorialURL.push({ url: urlAcutal });
                }
            }

        } else {
            let listaUno = []
            listaUno.push({ url: urlAcutal });
            HistorialURL = listaUno;
        }

        localStorage.setItem('HistorialURL', JSON.stringify(HistorialURL));

        /* (KCPB) Ayuda a deshabilitar el click derecho del ratón,
         * deshabilita las opciones de copiar, cortar y pegar */
        //function CopiarCortarPegar(valor) {
        //    if (valor) {
        //        document.oncopy = function (e) {
        //            e.preventDefault();
        //            $.notify({ icon: 'fas fa-times', message: 'La opción de copiar está deshabilitada...!!' }, { type: 'danger' });
        //        }
        //        document.oncut = function (e) {
        //            e.preventDefault();
        //            $.notify({ icon: 'fas fa-times', message: 'La opción de cortar está deshabilitado...!!' }, { type: 'danger' });
        //        }
        //        document.onpaste = function (e) {
        //            e.preventDefault();
        //            $.notify({ icon: 'fas fa-times', message: 'La opción de pegar está deshabilitado...!!' }, { type: 'danger' });
        //        }
        //        document.addEventListener("contextmenu", function (e) {
        //            e.preventDefault();
        //            $.notify({ icon: 'fas fa-times', message: 'El menú contextual está deshabilitado...!!' }, { type: 'danger' });
        //        }, false);
        //    }
        //}

        //Funcion que valida rutas definidas
        Routes()
        function Routes() {
            $.ajax({
                type: 'POST',
                url: '<%= ResolveUrl("Inicio/Sigrh.aspx/RoutesUser")%>',
                dataType: 'json',
                contentType: 'application/json; charset=utf-8',
                success: function (response) {
                    ValidarRoutes(response.d);
                    //console.log('response', response)
                },
                error: function (result) {
                    $.notify('ERROR!! ' + result.status + ' ' + result.statusText, 'error')
                }
            })
        }

        function ValidarRoutes(p_items) {
            let validado = true;
            for (let i in p_items) {
                if (p_items[i].me_url !== undefined && p_items[i].me_url !== null && p_items[i].me_url !== "") {
                    let routeAsignado = p_items[i].me_url;
                    routeAsignado = routeAsignado.split('/')[2];
                    if (routeAsignado === urlAcutal) {
                        validado = true;
                        break;
                    } else {
                        validado = false;
                    }
                }
            }
            if (urlAcutal === 'Sigrh') {
                validado = true;
            }
            //if (!validado) {
            //    location.href = "../Inicio/Sigrh";
            //}
        }


    </script>
