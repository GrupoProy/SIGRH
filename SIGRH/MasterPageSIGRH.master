        <!-- Demo JS - remove this in your project -->
        <script src="<%= ResolveUrl("Content/js/demo.min.js") %>"></script>
        <script src="<%= ResolveUrl("Content/js/Scripts.js") %>"></script>
        <script>
            // Ejecutamos el menú
            GetMenu()
            // Función para cargar el menú
            function GetMenu() {
                $.ajax({
                    type: 'POST',
                    url: '<%= ResolveUrl("Inicio/Sigrh.aspx/BindMenuAjax")%>',
                    dataType: 'json',
                    contentType: 'application/json; charset=utf-8',
                    success: function (response) {
                        ConstruirMenu($('#menuPrincipal'), response.d);
                    },
                    error: function (result) {
                        $.notify('ERROR!! ' + result.status + ' ' + result.statusText, 'error')
                    }
                })
            }
            // Función para ayudar a generar el menú
            let colores = ['text-gray', 'text-teal', 'text-cyan', 'text-lighter', 'text-warning', 'text-icon-mn-1', 'text-icon-mn-2', 'text-icon-mn-3', 'text-icon-mn-4', 'text-icon-mn-5', 'text-icon-mn-6', 'text-icon-mn-7', 'text-white', 'text-pink', 'text-green', 'text-success']
            let k = 0
            function ConstruirMenu(parent, items) {
                $.each(items, function () {
                    var li
                    if (this.me_vista) {
                        if (this.me_url != '#') {
                            li = $('<li class="nav-item">' +
                                '<a class="nav-link text-secondary" href="' + this.me_url + '" onclick="MostrarMascara(true)">' +
                                '<i class="' + this.me_icono + ' text-white"></i>' +
                                '<span class="nav-link-text">' + this.me_descripcion + '</span>' +
                                '</a>' +
                                '</li>')
                        } else {
                            if (colores[k] !== undefined && colores[k] !== null && colores[k] !== '') { } else { k = 0; }
                            li = $('<li class="nav-item">' +
                                '<a class="nav-link text-secondary2" id="p-' + this.me_id + '"href="#navbar-' + this.me_id + '" data-toggle="collapse" role="button" aria-expanded="false" aria-controls="navbar-' + this.me_id + '">' +
                                '<i class="' + this.me_icono + ' ' + colores[k] + '"></i>' +
                                '<span class="nav-link-text">' + this.me_descripcion + '</span>' +
                                '</a>' +
                                '</li>')
                            k++;
                        }
                        li.appendTo(parent)
                        if (this.me_lista && this.me_lista.length > 0) {
                            var div = $('<div class="collapse" id="navbar-' + this.me_id + '"></div>')
                            var ul = $('<ul class="nav nav-sm flex-column"></ul>')
                            ul.appendTo(div)
                            div.appendTo(li)
                            ConstruirMenu(ul, this.me_lista)
                        }

                    }
                })


                let swMenu = showFocus(items, urlAcutal);
                if (!swMenu) {
                    if (urlAcutal !== 'Sigrh') {
                        let HistorialURL = JSON.parse(localStorage.getItem('HistorialURL'));
                        let urlPadre = HistorialURL[HistorialURL.length - 2];
                        urlPadre = urlPadre.url;
                        swMenu = showFocus(items, urlPadre);
                    }
                }
            }

            function showFocus(p_items, p_urlAcutal) {
                let sw = false;
                for (let i in p_items) {
                    if (p_items[i].me_lista.length > 0) {
                        let listaM = p_items[i].me_lista;
                        for (let j in listaM) {
                            var urlArbol = listaM[j].me_url.split('.aspx')[0];
                            urlArbol = listaM[j].me_url.split('/')[2];
                            if (urlArbol === p_urlAcutal) {
                                let idDiv = "#navbar-" + p_items[i].me_id;
                                let idA = "#p-" + p_items[i].me_id;
                                $(idDiv).addClass("collapse show");
                                $(idA).addClass("nav-link text-secondary2 active");
                                $(idA).attr("aria-expanded", "true");
                                sw = true;
                                break;
                            }
                        }
                    }
                }
                return sw;
            }
        </script>

        <div class="backdrop d-xl-none" data-action="sidenav-unpin" data-target="undefined"></div>
    </form>
</body>
</html>
