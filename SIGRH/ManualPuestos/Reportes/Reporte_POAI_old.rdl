  <DataSets>
    <DataSet Name="IDENTIFICACION">
      <Query>
        <DataSourceName>Planillas</DataSourceName>
        <QueryParameters>
          <QueryParameter Name="@poai_id">
            <Value>=Parameters!poai_id.Value</Value>
          </QueryParameter>
        </QueryParameters>
        <CommandText>SELECT DISTINCT 
                         tbl_mdp_poai.poai_id, tbl_mdp_poai.poai_ca_id, RTRIM(tbl_mdp_puesto.pu_nombre_puesto) AS puesto, RTRIM(tbl_mp_escala_salarial.es_descripcion) AS cargo, 
                         RTRIM(tbl_mp_estructura_organizacional.eo_descripcion) AS unidad_organizacional, RTRIM(tbl_mdp_puesto.pu_objetivo) AS objetivo, RTRIM(tbl_mp_cargo.ca_ti_item) + '  ' + RTRIM(tbl_mp_cargo.ca_num_item) 
                         AS item, tbl_mp_escala_salarial.es_categoria, RTRIM(tbl_mp_nivel_escala.ne_categoria) AS nivel, RTRIM(tbl_mp_nivel_escala.ne_nivel_interno) AS SUBnivel, tbl_requisito_formacion.rf_formacion, 
                         tbl_requisito_formacion.rf_exp_gral, tbl_requisito_formacion.rf_exp_esp
FROM            tbl_mp_escala_salarial INNER JOIN
                         tbl_mdp_poai INNER JOIN
                         tbl_mp_cargo ON tbl_mdp_poai.poai_ca_id = tbl_mp_cargo.ca_id INNER JOIN
                         tbl_mp_estructura_organizacional ON tbl_mp_cargo.ca_eo_id = tbl_mp_estructura_organizacional.eo_id ON tbl_mp_escala_salarial.es_id = tbl_mp_cargo.ca_es_id INNER JOIN
                         tbl_mdp_poai_formacion ON tbl_mdp_poai.poai_id = tbl_mdp_poai_formacion.ifo_poai_id INNER JOIN
                         tbl_mdp_puesto ON tbl_mdp_poai.poai_id = tbl_mdp_puesto.pu_poai_id INNER JOIN
                         tbl_mp_nivel_escala ON tbl_mp_escala_salarial.es_ne_id = tbl_mp_nivel_escala.ne_id INNER JOIN
                         tbl_requisito_formacion ON tbl_mp_escala_salarial.es_rf_id = tbl_requisito_formacion.rf_id
WHERE    tbl_mdp_poai.poai_id = @poai_id
ORDER BY tbl_mdp_poai.poai_id</CommandText>
        <rd:UseGenericDesigner>true</rd:UseGenericDesigner>
      </Query>
      <Fields>
        <Field Name="poai_id">
          <DataField>poai_id</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
        <Field Name="poai_ca_id">
          <DataField>poai_ca_id</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
        <Field Name="puesto">
          <DataField>puesto</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="cargo">
          <DataField>cargo</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="unidad_organizacional">
          <DataField>unidad_organizacional</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="objetivo">
          <DataField>objetivo</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="item">
          <DataField>item</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="es_categoria">
          <DataField>es_categoria</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="nivel">
          <DataField>nivel</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="SUBnivel">
          <DataField>SUBnivel</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="rf_formacion">
          <DataField>rf_formacion</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="rf_exp_gral">
          <DataField>rf_exp_gral</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="rf_exp_esp">
          <DataField>rf_exp_esp</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
      </Fields>
    </DataSet>
    <DataSet Name="RESULTADOS_ESPECIFICOS">
      <Query>
        <DataSourceName>Planillas</DataSourceName>
        <QueryParameters>
          <QueryParameter Name="@poai_id">
            <Value>=Parameters!poai_id.Value</Value>
          </QueryParameter>
        </QueryParameters>
        <CommandText>SELECT         tbl_mdp_resultados_especificos.res_id, tbl_mdp_resultados_especificos.res_poai_id, tbl_mdp_resultados_especificos.res_descripcion, tbl_mdp_resultados_especificos.res_indicador, 
                         tbl_mdp_resultados_especificos.res_puntaje, tbl_mdp_resultados_especificos.res_estado
FROM            tbl_mdp_resultados_especificos INNER JOIN
                         tbl_mdp_poai ON tbl_mdp_resultados_especificos.res_poai_id = tbl_mdp_poai.poai_id INNER JOIN
                         tbl_mp_cargo ON tbl_mdp_poai.poai_ca_id = tbl_mp_cargo.ca_id INNER JOIN
                         tbl_mp_estructura_organizacional ON tbl_mp_cargo.ca_eo_id = tbl_mp_estructura_organizacional.eo_id
WHERE    tbl_mdp_poai.poai_id = @poai_id AND  (tbl_mdp_poai.poai_estado = 'v') AND  tbl_mdp_resultados_especificos.res_estado='v'</CommandText>
      </Query>
      <Fields>
        <Field Name="res_id">
          <DataField>res_id</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
        <Field Name="res_poai_id">
          <DataField>res_poai_id</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
        <Field Name="res_descripcion">
          <DataField>res_descripcion</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="res_indicador">
          <DataField>res_indicador</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="res_puntaje">
          <DataField>res_puntaje</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
        <Field Name="res_estado">
          <DataField>res_estado</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
      </Fields>
    </DataSet>
    <DataSet Name="TAREAS_RECURRENTES">
      <Query>
        <DataSourceName>Planillas</DataSourceName>
        <QueryParameters>
          <QueryParameter Name="@poai_id">
            <Value>=Parameters!poai_id.Value</Value>
          </QueryParameter>
        </QueryParameters>
        <CommandText>SELECT        tbl_mdp_tareas_recurrentes.tar_id, tbl_mdp_tareas_recurrentes.tar_poai_id, tbl_mdp_tareas_recurrentes.tar_descripcion, tbl_mdp_tareas_recurrentes.tar_estado
FROM            tbl_mp_estructura_organizacional INNER JOIN
                         tbl_mp_cargo ON tbl_mp_estructura_organizacional.eo_id = tbl_mp_cargo.ca_eo_id INNER JOIN
                         tbl_mdp_tareas_recurrentes INNER JOIN
                         tbl_mdp_poai ON tbl_mdp_tareas_recurrentes.tar_poai_id = tbl_mdp_poai.poai_id ON tbl_mp_cargo.ca_id = tbl_mdp_poai.poai_ca_id
WHERE     tbl_mdp_poai.poai_id = @poai_id  AND (tbl_mdp_poai.poai_estado = 'v') AND (tbl_mdp_tareas_recurrentes.tar_estado = 'v')</CommandText>
      </Query>
      <Fields>
        <Field Name="tar_id">
          <DataField>tar_id</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
        <Field Name="tar_poai_id">
          <DataField>tar_poai_id</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
        <Field Name="tar_descripcion">
          <DataField>tar_descripcion</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="tar_estado">
          <DataField>tar_estado</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
      </Fields>
    </DataSet>
    <DataSet Name="CONOCIMIENTOS">
      <Query>
        <DataSourceName>Planillas</DataSourceName>
        <QueryParameters>
          <QueryParameter Name="@poai_id">
            <Value>=Parameters!poai_id.Value</Value>
          </QueryParameter>
        </QueryParameters>
        <CommandText>SELECT        tbl_mdp_poai_conocimiento.ico_id, tbl_mdp_poai_conocimiento.ico_poai_id, tbl_mdp_poai_conocimiento.ico_co_id, tbl_mdp_poai_conocimiento.ico_estado, tbl_mdp_conocimiento.co_descripcion
FROM            tbl_mdp_poai_conocimiento INNER JOIN
                         tbl_mp_estructura_organizacional INNER JOIN
                         tbl_mp_cargo ON tbl_mp_estructura_organizacional.eo_id = tbl_mp_cargo.ca_eo_id INNER JOIN
                         tbl_mdp_poai ON tbl_mp_cargo.ca_id = tbl_mdp_poai.poai_ca_id ON tbl_mdp_poai_conocimiento.ico_poai_id = tbl_mdp_poai.poai_id INNER JOIN
                         tbl_mdp_conocimiento ON tbl_mdp_poai_conocimiento.ico_co_id = tbl_mdp_conocimiento.co_id
WHERE      tbl_mdp_poai.poai_id = @poai_id  AND (tbl_mdp_poai.poai_estado = 'v') AND (tbl_mdp_poai_conocimiento.ico_estado = 'V') AND (tbl_mdp_conocimiento.co_estado = 'V')
</CommandText>
      </Query>
      <Fields>
        <Field Name="ico_id">
          <DataField>ico_id</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
        <Field Name="ico_poai_id">
          <DataField>ico_poai_id</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
        <Field Name="ico_co_id">
          <DataField>ico_co_id</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
        <Field Name="ico_estado">
          <DataField>ico_estado</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="co_descripcion">
          <DataField>co_descripcion</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
      </Fields>
    </DataSet>
    <DataSet Name="SUPERVISION">
      <Query>
        <DataSourceName>Planillas</DataSourceName>
        <QueryParameters>
          <QueryParameter Name="@poai_id">
            <Value>=Parameters!poai_id.Value</Value>
          </QueryParameter>
        </QueryParameters>
        <CommandText>SELECT        tbl_mdp_poai_supervision.isup_poai_id, tbl_mdp_poai_supervision.isup_poai_supervision, tbl_mdp_poai_supervision.isup_cantidad, tbl_mdp_poai_supervision.isup_estado, 
(tbl_mp_cargo.ca_ti_item) + '  ' + RTRIM(tbl_mp_cargo.ca_num_item)  AS item_SUP,
 tbl_mp_escala_salarial.es_descripcion
FROM            tbl_mdp_poai INNER JOIN
                         tbl_mp_cargo AS tbl_mp_cargo_1 INNER JOIN
                         tbl_mp_estructura_organizacional ON tbl_mp_cargo_1.ca_eo_id = tbl_mp_estructura_organizacional.eo_id ON tbl_mdp_poai.poai_ca_id = tbl_mp_cargo_1.ca_id INNER JOIN
                         tbl_mdp_poai_supervision INNER JOIN
                         tbl_mdp_poai AS tbl_mdp_poai_1 ON tbl_mdp_poai_supervision.isup_poai_supervision = tbl_mdp_poai_1.poai_id INNER JOIN
                         tbl_mp_cargo ON tbl_mdp_poai_1.poai_ca_id = tbl_mp_cargo.ca_id INNER JOIN
                         tbl_mp_escala_salarial ON tbl_mp_cargo.ca_es_id = tbl_mp_escala_salarial.es_id ON tbl_mdp_poai.poai_id = tbl_mdp_poai_supervision.isup_poai_id
WHERE      tbl_mdp_poai.poai_id = @poai_id and   (tbl_mdp_poai_supervision.isup_estado = 'V')
AND (tbl_mdp_poai_supervision.isup_poai_id &lt;&gt; tbl_mdp_poai_supervision.isup_poai_supervision)
ORDER BY tbl_mp_cargo.ca_num_item</CommandText>
      </Query>
      <Fields>
        <Field Name="isup_poai_id">
          <DataField>isup_poai_id</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
        <Field Name="isup_poai_supervision">
          <DataField>isup_poai_supervision</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
        <Field Name="isup_cantidad">
          <DataField>isup_cantidad</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
        <Field Name="isup_estado">
          <DataField>isup_estado</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="item_SUP">
          <DataField>item_SUP</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="es_descripcion">
          <DataField>es_descripcion</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
      </Fields>
    </DataSet>
    <DataSet Name="RESPONSABILIDAD">
      <Query>
        <DataSourceName>Planillas</DataSourceName>
        <QueryParameters>
          <QueryParameter Name="@poai_id">
            <Value>=Parameters!poai_id.Value</Value>
          </QueryParameter>
        </QueryParameters>
        <CommandText>SELECT        tbl_mdp_responsabilidad.irespons_id, tbl_mdp_responsabilidad.irespons_poai_id, tbl_mdp_responsabilidad.irespons_cat_id, tbl_mdp_responsabilidad.irespons_estado, tbl_mp_cargo.ca_ti_item, 
                         tbl_mp_cargo.ca_num_item, General.dbo.tbl_catalogo.cat_descripcion, General.dbo.tbl_catalogo.cat_id
FROM            tbl_mdp_responsabilidad INNER JOIN
                         tbl_mdp_poai ON tbl_mdp_responsabilidad.irespons_poai_id = tbl_mdp_poai.poai_id INNER JOIN
                         tbl_mp_cargo ON tbl_mdp_poai.poai_ca_id = tbl_mp_cargo.ca_id INNER JOIN
                         General.dbo.tbl_catalogo ON tbl_mdp_responsabilidad.irespons_cat_id = General.dbo.tbl_catalogo.cat_id INNER JOIN
                         tbl_mp_estructura_organizacional ON tbl_mp_cargo.ca_eo_id = tbl_mp_estructura_organizacional.eo_id
WHERE     tbl_mdp_poai.poai_id = @poai_id AND   (tbl_mdp_responsabilidad.irespons_estado = 'V') 
ORDER BY tbl_mp_cargo.ca_ti_item, tbl_mp_cargo.ca_num_item</CommandText>
      </Query>
      <Fields>
        <Field Name="irespons_id">
          <DataField>irespons_id</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
        <Field Name="irespons_poai_id">
          <DataField>irespons_poai_id</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
        <Field Name="irespons_cat_id">
          <DataField>irespons_cat_id</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
        <Field Name="irespons_estado">
          <DataField>irespons_estado</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="ca_ti_item">
          <DataField>ca_ti_item</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="ca_num_item">
          <DataField>ca_num_item</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
        <Field Name="cat_descripcion">
          <DataField>cat_descripcion</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="cat_id">
          <DataField>cat_id</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
      </Fields>
    </DataSet>
    <DataSet Name="FORMACION_OBLIGATORIA">
      <Query>
        <DataSourceName>Planillas</DataSourceName>
        <QueryParameters>
          <QueryParameter Name="@poai_id">
            <Value>=Parameters!poai_id.Value</Value>
          </QueryParameter>
        </QueryParameters>
        <CommandText>SELECT        tbl_mdp_poai_formacion.ifo_id, tbl_mdp_poai_formacion.ifo_poai_id, tbl_mdp_poai_formacion.ifo_fo_id, tbl_mdp_poai_formacion.ifo_estado, tbl_mdp_formacion.fo_descripcion, 
                         RTRIM(tbl_mdp_formacion.fo_tipo) AS TIPO_FORMACION
FROM            tbl_mdp_poai_formacion INNER JOIN
                         tbl_mdp_formacion ON tbl_mdp_poai_formacion.ifo_fo_id = tbl_mdp_formacion.fo_id
WHERE      RTRIM(tbl_mdp_formacion.fo_tipo) ='FO'
AND   tbl_mdp_poai_formacion.ifo_poai_id = @poai_id
AND (tbl_mdp_poai_formacion.ifo_estado = 'V')</CommandText>
      </Query>
      <Fields>
        <Field Name="ifo_id">
          <DataField>ifo_id</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
        <Field Name="ifo_poai_id">
          <DataField>ifo_poai_id</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
        <Field Name="ifo_fo_id">
          <DataField>ifo_fo_id</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
        <Field Name="ifo_estado">
          <DataField>ifo_estado</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="fo_descripcion">
          <DataField>fo_descripcion</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="TIPO_FORMACION">
          <DataField>TIPO_FORMACION</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
      </Fields>
    </DataSet>
    <DataSet Name="FORMACION_COMPLEMENTARIA">
      <Query>
        <DataSourceName>Planillas</DataSourceName>
        <QueryParameters>
          <QueryParameter Name="@poai_id">
            <Value>=Parameters!poai_id.Value</Value>
          </QueryParameter>
        </QueryParameters>
        <CommandText>SELECT        tbl_mdp_poai_formacion.ifo_id, tbl_mdp_poai_formacion.ifo_poai_id, tbl_mdp_poai_formacion.ifo_fo_id, tbl_mdp_poai_formacion.ifo_estado, tbl_mdp_formacion.fo_descripcion, 
                         RTRIM(tbl_mdp_formacion.fo_tipo) AS TIPO_FORMACION
FROM            tbl_mdp_poai_formacion INNER JOIN
                         tbl_mdp_formacion ON tbl_mdp_poai_formacion.ifo_fo_id = tbl_mdp_formacion.fo_id
WHERE      RTRIM(tbl_mdp_formacion.fo_tipo) ='FC'
AND tbl_mdp_poai_formacion.ifo_poai_id = @poai_id
AND (tbl_mdp_poai_formacion.ifo_estado = 'V')</CommandText>
      </Query>
      <Fields>
        <Field Name="ifo_id">
          <DataField>ifo_id</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
        <Field Name="ifo_poai_id">
          <DataField>ifo_poai_id</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
        <Field Name="ifo_fo_id">
          <DataField>ifo_fo_id</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
        <Field Name="ifo_estado">
          <DataField>ifo_estado</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="fo_descripcion">
          <DataField>fo_descripcion</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="TIPO_FORMACION">
          <DataField>TIPO_FORMACION</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
      </Fields>
    </DataSet>
