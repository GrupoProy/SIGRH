<?xml version="1.0" encoding="utf-8"?>
<Report MustUnderstand="df" xmlns="http://schemas.microsoft.com/sqlserver/reporting/2016/01/reportdefinition" xmlns:rd="http://schemas.microsoft.com/SQLServer/reporting/reportdesigner" xmlns:df="http://schemas.microsoft.com/sqlserver/reporting/2016/01/reportdefinition/defaultfontfamily">
  <df:DefaultFontFamily>Segoe UI</df:DefaultFontFamily>
  <AutoRefresh>0</AutoRefresh>
  <DataSources>
    <DataSource Name="Planillas">
      <DataSourceReference>Planillas</DataSourceReference>
      <rd:SecurityType>None</rd:SecurityType>
      <rd:DataSourceID>0ff8f6a0-5556-4f22-a81e-509069c7a297</rd:DataSourceID>
    </DataSource>
  </DataSources>
  <DataSets>
    <DataSet Name="IDENTIFICACION">
      <Query>
        <DataSourceName>Planillas</DataSourceName>
        <QueryParameters>
          <QueryParameter Name="@poai_id">
            <Value>=Parameters!poai_id.Value</Value>
          </QueryParameter>
        </QueryParameters>
        <CommandText>SELECT DISTINCT 
                         SIGRH3.dbo.tbl_mdp_poai.poai_id, SIGRH3.dbo.tbl_mdp_poai.poai_ca_id, RTRIM(SIGRH3.dbo.tbl_mdp_puesto.pu_nombre_puesto) AS puesto, RTRIM(SIGRH3.dbo.tbl_mp_escala_salarial.es_descripcion) 
                         AS cargo, RTRIM(SIGRH3.dbo.tbl_mp_estructura_organizacional.eo_descripcion) AS unidad_organizacional, RTRIM(SIGRH3.dbo.tbl_mdp_puesto.pu_objetivo) AS objetivo, 
                         RTRIM(SIGRH3.dbo.tbl_mp_cargo.ca_ti_item) + '  ' + RTRIM(SIGRH3.dbo.tbl_mp_cargo.ca_num_item) AS item, SIGRH3.dbo.tbl_mp_escala_salarial.es_categoria, 
                         RTRIM(SIGRH3.dbo.tbl_mp_nivel_escala.ne_categoria) AS nivel, RTRIM(SIGRH3.dbo.tbl_mp_nivel_escala.ne_nivel_interno) AS SUBnivel, SIGRH3.dbo.tbl_requisito_formacion.rf_formacion, 
                         SIGRH3.dbo.tbl_requisito_formacion.rf_exp_gral, SIGRH3.dbo.tbl_requisito_formacion.rf_exp_esp, General.dbo.tbl_periodo.pr_gestion
FROM           SIGRH3.dbo.tbl_mp_escala_salarial INNER JOIN
                         SIGRH3.dbo.tbl_mdp_poai INNER JOIN
                         SIGRH3.dbo.tbl_mp_cargo ON SIGRH3.dbo.tbl_mdp_poai.poai_ca_id = SIGRH3.dbo.tbl_mp_cargo.ca_id INNER JOIN
                         SIGRH3.dbo.tbl_mp_estructura_organizacional ON SIGRH3.dbo.tbl_mp_cargo.ca_eo_id = SIGRH3.dbo.tbl_mp_estructura_organizacional.eo_id ON 
                         SIGRH3.dbo.tbl_mp_escala_salarial.es_id = SIGRH3.dbo.tbl_mp_cargo.ca_es_id INNER JOIN
                         SIGRH3.dbo.tbl_mdp_poai_formacion ON SIGRH3.dbo.tbl_mdp_poai.poai_id = SIGRH3.dbo.tbl_mdp_poai_formacion.ifo_poai_id INNER JOIN
                         SIGRH3.dbo.tbl_mdp_puesto ON SIGRH3.dbo.tbl_mdp_poai.poai_id = SIGRH3.dbo.tbl_mdp_puesto.pu_poai_id  AND tbl_mdp_puesto.pu_estado='V'  INNER JOIN
                         SIGRH3.dbo.tbl_mp_nivel_escala ON SIGRH3.dbo.tbl_mp_escala_salarial.es_ne_id = SIGRH3.dbo.tbl_mp_nivel_escala.ne_id INNER JOIN
                         SIGRH3.dbo.tbl_requisito_formacion ON SIGRH3.dbo.tbl_mp_escala_salarial.es_rf_id = SIGRH3.dbo.tbl_requisito_formacion.rf_id INNER JOIN
                         General.dbo.tbl_periodo ON SIGRH3.dbo.tbl_mdp_poai.poai_pr_id = tbl_periodo.pr_id
WHERE        (SIGRH3.dbo.tbl_mdp_poai.poai_id = @poai_id)
ORDER BY SIGRH3.dbo.tbl_mdp_poai.poai_id</CommandText>
        <rd:UseGenericDesigner>true</rd:UseGenericDesigner>
      </Query>
      <Fields>
        <Field Name="poai_id">
          <DataField>poai_id</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
        <Field Name="poai_ca_id">
          <DataField>poai_ca_id</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
        <Field Name="puesto">
          <DataField>puesto</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="cargo">
          <DataField>cargo</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="unidad_organizacional">
          <DataField>unidad_organizacional</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="objetivo">
          <DataField>objetivo</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="item">
          <DataField>item</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="es_categoria">
          <DataField>es_categoria</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="nivel">
          <DataField>nivel</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="SUBnivel">
          <DataField>SUBnivel</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="rf_formacion">
          <DataField>rf_formacion</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="rf_exp_gral">
          <DataField>rf_exp_gral</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="rf_exp_esp">
          <DataField>rf_exp_esp</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="pr_gestion">
          <DataField>pr_gestion</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
      </Fields>
    </DataSet>
    <DataSet Name="RESULTADOS_ESPECIFICOS">
      <Query>
        <DataSourceName>Planillas</DataSourceName>
        <QueryParameters>
          <QueryParameter Name="@poai_id">
            <Value>=Parameters!poai_id.Value</Value>
          </QueryParameter>
        </QueryParameters>
        <CommandText>SELECT        SIGRH3.dbo.tbl_mdp_resultados_especificos.res_id, SIGRH3.dbo.tbl_mdp_resultados_especificos.res_poai_id, SIGRH3.dbo.tbl_mdp_resultados_especificos.res_descripcion, 
                         SIGRH3.dbo.tbl_mdp_resultados_especificos.res_indicador, SIGRH3.dbo.tbl_mdp_resultados_especificos.res_puntaje, SIGRH3.dbo.tbl_mdp_resultados_especificos.res_estado
FROM            SIGRH3.dbo.tbl_mdp_resultados_especificos INNER JOIN
                         SIGRH3.dbo.tbl_mdp_poai ON SIGRH3.dbo.tbl_mdp_resultados_especificos.res_poai_id = SIGRH3.dbo.tbl_mdp_poai.poai_id INNER JOIN
                         SIGRH3.dbo.tbl_mp_cargo ON SIGRH3.dbo.tbl_mdp_poai.poai_ca_id = SIGRH3.dbo.tbl_mp_cargo.ca_id INNER JOIN
                         SIGRH3.dbo.tbl_mp_estructura_organizacional ON SIGRH3.dbo.tbl_mp_cargo.ca_eo_id = SIGRH3.dbo.tbl_mp_estructura_organizacional.eo_id
WHERE        (SIGRH3.dbo.tbl_mdp_poai.poai_id = @poai_id) AND (SIGRH3.dbo.tbl_mdp_poai.poai_estado = 'v') AND (SIGRH3.dbo.tbl_mdp_resultados_especificos.res_estado = 'v')</CommandText>
      </Query>
      <Fields>
        <Field Name="res_id">
          <DataField>res_id</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
        <Field Name="res_poai_id">
          <DataField>res_poai_id</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
        <Field Name="res_descripcion">
          <DataField>res_descripcion</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="res_indicador">
          <DataField>res_indicador</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="res_puntaje">
          <DataField>res_puntaje</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
        <Field Name="res_estado">
          <DataField>res_estado</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
      </Fields>
    </DataSet>
    <DataSet Name="TAREAS_RECURRENTES">
      <Query>
        <DataSourceName>Planillas</DataSourceName>
        <QueryParameters>
          <QueryParameter Name="@poai_id">
            <Value>=Parameters!poai_id.Value</Value>
          </QueryParameter>
        </QueryParameters>
        <CommandText>SELECT        SIGRH3.dbo.tbl_mdp_tareas_recurrentes.tar_id, SIGRH3.dbo.tbl_mdp_tareas_recurrentes.tar_poai_id, SIGRH3.dbo.tbl_mdp_tareas_recurrentes.tar_descripcion, 
                         SIGRH3.dbo.tbl_mdp_tareas_recurrentes.tar_estado
FROM            SIGRH3.dbo.tbl_mp_estructura_organizacional INNER JOIN
                         SIGRH3.dbo.tbl_mp_cargo ON SIGRH3.dbo.tbl_mp_estructura_organizacional.eo_id = SIGRH3.dbo.tbl_mp_cargo.ca_eo_id INNER JOIN
                         SIGRH3.dbo.tbl_mdp_tareas_recurrentes INNER JOIN
                         SIGRH3.dbo.tbl_mdp_poai ON SIGRH3.dbo.tbl_mdp_tareas_recurrentes.tar_poai_id = SIGRH3.dbo.tbl_mdp_poai.poai_id ON SIGRH3.dbo.tbl_mp_cargo.ca_id = SIGRH3.dbo.tbl_mdp_poai.poai_ca_id
WHERE        (SIGRH3.dbo.tbl_mdp_poai.poai_id = @poai_id) AND (SIGRH3.dbo.tbl_mdp_poai.poai_estado = 'v') AND (SIGRH3.dbo.tbl_mdp_tareas_recurrentes.tar_estado = 'v')</CommandText>
      </Query>
      <Fields>
        <Field Name="tar_id">
          <DataField>tar_id</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
        <Field Name="tar_poai_id">
          <DataField>tar_poai_id</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
        <Field Name="tar_descripcion">
          <DataField>tar_descripcion</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="tar_estado">
          <DataField>tar_estado</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
      </Fields>
    </DataSet>
    <DataSet Name="CONOCIMIENTOS">
      <Query>
        <DataSourceName>Planillas</DataSourceName>
        <QueryParameters>
          <QueryParameter Name="@poai_id">
            <Value>=Parameters!poai_id.Value</Value>
          </QueryParameter>
        </QueryParameters>
        <CommandText>SELECT        SIGRH3.dbo.tbl_mdp_poai_conocimiento.ico_id, SIGRH3.dbo.tbl_mdp_poai_conocimiento.ico_poai_id, SIGRH3.dbo.tbl_mdp_poai_conocimiento.ico_co_id, SIGRH3.dbo.tbl_mdp_poai_conocimiento.ico_estado, 
                         SIGRH3.dbo.tbl_mdp_conocimiento.co_descripcion
FROM            SIGRH3.dbo.tbl_mdp_poai_conocimiento INNER JOIN
                         SIGRH3.dbo.tbl_mp_estructura_organizacional INNER JOIN
                         SIGRH3.dbo.tbl_mp_cargo ON SIGRH3.dbo.tbl_mp_estructura_organizacional.eo_id = SIGRH3.dbo.tbl_mp_cargo.ca_eo_id INNER JOIN
                         SIGRH3.dbo.tbl_mdp_poai ON SIGRH3.dbo.tbl_mp_cargo.ca_id = SIGRH3.dbo.tbl_mdp_poai.poai_ca_id ON SIGRH3.dbo.tbl_mdp_poai_conocimiento.ico_poai_id = SIGRH3.dbo.tbl_mdp_poai.poai_id INNER JOIN
                         SIGRH3.dbo.tbl_mdp_conocimiento ON SIGRH3.dbo.tbl_mdp_poai_conocimiento.ico_co_id = SIGRH3.dbo.tbl_mdp_conocimiento.co_id
WHERE        (SIGRH3.dbo.tbl_mdp_poai.poai_id = @poai_id) AND (SIGRH3.dbo.tbl_mdp_poai.poai_estado = 'v') AND (SIGRH3.dbo.tbl_mdp_poai_conocimiento.ico_estado = 'V') AND 
                         (SIGRH3.dbo.tbl_mdp_conocimiento.co_estado = 'V')</CommandText>
      </Query>
      <Fields>
        <Field Name="ico_id">
          <DataField>ico_id</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
        <Field Name="ico_poai_id">
          <DataField>ico_poai_id</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
        <Field Name="ico_co_id">
          <DataField>ico_co_id</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
        <Field Name="ico_estado">
          <DataField>ico_estado</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="co_descripcion">
          <DataField>co_descripcion</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
      </Fields>
    </DataSet>
    <DataSet Name="SUPERVISION">
      <Query>
        <DataSourceName>Planillas</DataSourceName>
        <QueryParameters>
          <QueryParameter Name="@poai_id">
            <Value>=Parameters!poai_id.Value</Value>
          </QueryParameter>
        </QueryParameters>
        <CommandText>SELECT        SIGRH3.dbo.tbl_mdp_poai_supervision_ejercida.se_poai_id, SIGRH3.dbo.tbl_mdp_poai_supervision_ejercida.se_poai_id_supervisa, SIGRH3.dbo.tbl_mdp_poai_supervision_ejercida.se_poai_superv_cantidad, 
                         SIGRH3.dbo.tbl_mdp_poai_supervision_ejercida.se_estado, SIGRH3.dbo.tbl_mp_cargo.ca_ti_item + '  ' + RTRIM(SIGRH3.dbo.tbl_mp_cargo.ca_num_item) AS item_SUP, 
                         SIGRH3.dbo.tbl_mp_escala_salarial.es_descripcion, SIGRH3.dbo.tbl_puestos.p_descripcion
FROM            SIGRH3.dbo.tbl_mdp_poai INNER JOIN
                         SIGRH3.dbo.tbl_mp_cargo AS tbl_mp_cargo_1 INNER JOIN
                         SIGRH3.dbo.tbl_mp_estructura_organizacional ON tbl_mp_cargo_1.ca_eo_id = SIGRH3.dbo.tbl_mp_estructura_organizacional.eo_id ON SIGRH3.dbo.tbl_mdp_poai.poai_ca_id = tbl_mp_cargo_1.ca_id INNER JOIN
                         SIGRH3.dbo.tbl_mdp_poai_supervision_ejercida INNER JOIN
                         SIGRH3.dbo.tbl_mdp_poai AS tbl_mdp_poai_1 ON SIGRH3.dbo.tbl_mdp_poai_supervision_ejercida.se_poai_id_supervisa = tbl_mdp_poai_1.poai_id INNER JOIN
                         SIGRH3.dbo.tbl_mp_cargo ON tbl_mdp_poai_1.poai_ca_id = SIGRH3.dbo.tbl_mp_cargo.ca_id INNER JOIN
                         SIGRH3.dbo.tbl_mp_escala_salarial ON SIGRH3.dbo.tbl_mp_cargo.ca_es_id = SIGRH3.dbo.tbl_mp_escala_salarial.es_id ON 
                         SIGRH3.dbo.tbl_mdp_poai.poai_id = SIGRH3.dbo.tbl_mdp_poai_supervision_ejercida.se_poai_id INNER JOIN
                         SIGRH3.dbo.tbl_mp_cargo_puesto ON SIGRH3.dbo.tbl_mp_cargo.ca_id = SIGRH3.dbo.tbl_mp_cargo_puesto.cap_ca_id AND SIGRH3.dbo.tbl_mp_cargo_puesto.cap_estado = 'V' INNER JOIN
                         SIGRH3.dbo.tbl_puestos ON SIGRH3.dbo.tbl_mp_cargo_puesto.cap_p_id = SIGRH3.dbo.tbl_puestos.p_id
WHERE        (SIGRH3.dbo.tbl_mdp_poai.poai_id = @poai_id) AND (SIGRH3.dbo.tbl_mdp_poai_supervision_ejercida.se_estado = 'V') AND 
                         (SIGRH3.dbo.tbl_mdp_poai_supervision_ejercida.se_poai_id &lt;&gt; SIGRH3.dbo.tbl_mdp_poai_supervision_ejercida.se_poai_id_supervisa)
ORDER BY SIGRH3.dbo.tbl_mp_cargo.ca_num_item</CommandText>
      </Query>
      <Fields>
        <Field Name="SE_poai_id">
          <DataField>se_poai_id</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
        <Field Name="SE_poai_ID_supervisA">
          <DataField>se_poai_id_supervisa</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
        <Field Name="SE_POAI_SUPERV_cantidad">
          <DataField>se_poai_superv_cantidad</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
        <Field Name="SE_estado">
          <DataField>se_estado</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="item_SUP">
          <DataField>item_SUP</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="es_descripcion">
          <DataField>es_descripcion</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="p_descripcion">
          <DataField>p_descripcion</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
      </Fields>
    </DataSet>
    <DataSet Name="RESPONSABILIDAD">
      <Query>
        <DataSourceName>Planillas</DataSourceName>
        <QueryParameters>
          <QueryParameter Name="@poai_id">
            <Value>=Parameters!poai_id.Value</Value>
          </QueryParameter>
        </QueryParameters>
        <CommandText>SELECT        SIGRH3.dbo.tbl_mdp_responsabilidad.irespons_id, SIGRH3.dbo.tbl_mdp_responsabilidad.irespons_poai_id, SIGRH3.dbo.tbl_mdp_responsabilidad.irespons_cat_id, 
                         SIGRH3.dbo.tbl_mdp_responsabilidad.irespons_estado, SIGRH3.dbo.tbl_mp_cargo.ca_ti_item, SIGRH3.dbo.tbl_mp_cargo.ca_num_item, General.dbo.tbl_catalogo.cat_descripcion, 
                         General.dbo.tbl_catalogo.cat_id
FROM            SIGRH3.dbo.tbl_mdp_responsabilidad INNER JOIN
                         SIGRH3.dbo.tbl_mdp_poai ON SIGRH3.dbo.tbl_mdp_responsabilidad.irespons_poai_id = SIGRH3.dbo.tbl_mdp_poai.poai_id INNER JOIN
                         SIGRH3.dbo.tbl_mp_cargo ON SIGRH3.dbo.tbl_mdp_poai.poai_ca_id = SIGRH3.dbo.tbl_mp_cargo.ca_id INNER JOIN
                         General.dbo.tbl_catalogo ON SIGRH3.dbo.tbl_mdp_responsabilidad.irespons_cat_id = General.dbo.tbl_catalogo.cat_id INNER JOIN
                         SIGRH3.dbo.tbl_mp_estructura_organizacional ON SIGRH3.dbo.tbl_mp_cargo.ca_eo_id = SIGRH3.dbo.tbl_mp_estructura_organizacional.eo_id
WHERE        (SIGRH3.dbo.tbl_mdp_poai.poai_id = @poai_id) AND (SIGRH3.dbo.tbl_mdp_responsabilidad.irespons_estado = 'V')
ORDER BY SIGRH3.dbo.tbl_mp_cargo.ca_ti_item, SIGRH3.dbo.tbl_mp_cargo.ca_num_item</CommandText>
      </Query>
      <Fields>
        <Field Name="irespons_id">
          <DataField>irespons_id</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
        <Field Name="irespons_poai_id">
          <DataField>irespons_poai_id</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
        <Field Name="irespons_cat_id">
          <DataField>irespons_cat_id</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
        <Field Name="irespons_estado">
          <DataField>irespons_estado</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="ca_ti_item">
          <DataField>ca_ti_item</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="ca_num_item">
          <DataField>ca_num_item</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
        <Field Name="cat_descripcion">
          <DataField>cat_descripcion</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="cat_id">
          <DataField>cat_id</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
      </Fields>
    </DataSet>
    <DataSet Name="FORMACION_OBLIGATORIA">
      <Query>
        <DataSourceName>Planillas</DataSourceName>
        <QueryParameters>
          <QueryParameter Name="@poai_id">
            <Value>=Parameters!poai_id.Value</Value>
          </QueryParameter>
        </QueryParameters>
        <CommandText>SELECT        SIGRH3.dbo.tbl_mdp_poai_formacion.ifo_id, SIGRH3.dbo.tbl_mdp_poai_formacion.ifo_poai_id, SIGRH3.dbo.tbl_mdp_poai_formacion.ifo_fo_id, SIGRH3.dbo.tbl_mdp_poai_formacion.ifo_estado, 
                         SIGRH3.dbo.tbl_mdp_formacion.fo_descripcion, RTRIM(SIGRH3.dbo.tbl_mdp_formacion.fo_tipo) AS TIPO_FORMACION
FROM            SIGRH3.dbo.tbl_mdp_poai_formacion INNER JOIN
                         SIGRH3.dbo.tbl_mdp_formacion ON SIGRH3.dbo.tbl_mdp_poai_formacion.ifo_fo_id = SIGRH3.dbo.tbl_mdp_formacion.fo_id
WHERE        (RTRIM(SIGRH3.dbo.tbl_mdp_formacion.fo_tipo) = 'FO') AND (SIGRH3.dbo.tbl_mdp_poai_formacion.ifo_poai_id = @poai_id) AND (SIGRH3.dbo.tbl_mdp_poai_formacion.ifo_estado = 'V')</CommandText>
      </Query>
      <Fields>
        <Field Name="ifo_id">
          <DataField>ifo_id</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
        <Field Name="ifo_poai_id">
          <DataField>ifo_poai_id</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
        <Field Name="ifo_fo_id">
          <DataField>ifo_fo_id</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
        <Field Name="ifo_estado">
          <DataField>ifo_estado</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="fo_descripcion">
          <DataField>fo_descripcion</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="TIPO_FORMACION">
          <DataField>TIPO_FORMACION</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
      </Fields>
    </DataSet>
    <DataSet Name="FORMACION_COMPLEMENTARIA">
      <Query>
        <DataSourceName>Planillas</DataSourceName>
        <QueryParameters>
          <QueryParameter Name="@poai_id">
            <Value>=Parameters!poai_id.Value</Value>
          </QueryParameter>
        </QueryParameters>
        <CommandText>SELECT        SIGRH3.dbo.tbl_mdp_poai_formacion.ifo_id, SIGRH3.dbo.tbl_mdp_poai_formacion.ifo_poai_id, SIGRH3.dbo.tbl_mdp_poai_formacion.ifo_fo_id, SIGRH3.dbo.tbl_mdp_poai_formacion.ifo_estado, 
                         SIGRH3.dbo.tbl_mdp_formacion.fo_descripcion, RTRIM(SIGRH3.dbo.tbl_mdp_formacion.fo_tipo) AS TIPO_FORMACION
FROM            SIGRH3.dbo.tbl_mdp_poai_formacion INNER JOIN
                         SIGRH3.dbo.tbl_mdp_formacion ON SIGRH3.dbo.tbl_mdp_poai_formacion.ifo_fo_id = SIGRH3.dbo.tbl_mdp_formacion.fo_id
WHERE        (RTRIM(SIGRH3.dbo.tbl_mdp_formacion.fo_tipo) = 'FC') AND (SIGRH3.dbo.tbl_mdp_poai_formacion.ifo_poai_id = @poai_id) AND (SIGRH3.dbo.tbl_mdp_poai_formacion.ifo_estado = 'V')</CommandText>
      </Query>
      <Fields>
        <Field Name="ifo_id">
          <DataField>ifo_id</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
        <Field Name="ifo_poai_id">
          <DataField>ifo_poai_id</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
        <Field Name="ifo_fo_id">
